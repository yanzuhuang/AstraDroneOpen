<launch>
  <arg name="enable_control" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="report_file" default="/tmp/astra_stage3_low_latest.csv"/>
  <arg name="task_config"
       default="$(find astra_tower_mission)/config/stage3_low_altitude.yaml"/>
  <arg name="bridge_config"
       default="$(find ego_gazebo_bridge)/config/stage3_low_altitude.yaml"/>
  <arg name="filtered_cloud_topic"
       default="/stage3_low/cloud_registered_filtered"/>
  <arg name="occupancy_topic" default="/grid_map/occupancy_inflate"/>
  <arg name="stamped_occupancy_topic"
       default="/stage3_low/occupancy_inflate"/>

  <include file="$(find ego_gazebo_bridge)/launch/ego_gazebo_bridge.launch">
    <arg name="enable_control" value="$(arg enable_control)"/>
    <arg name="auto_track_on_command" value="false"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="bridge_config_file" value="$(arg bridge_config)"/>
    <arg name="cloud_topic" value="/cloud_registered"/>
    <arg name="bridge_cloud_topic" value="$(arg filtered_cloud_topic)"/>
    <arg name="ego_cloud_topic" value="$(arg filtered_cloud_topic)"/>
    <arg name="filter_ground_cloud" value="true"/>
    <arg name="filtered_cloud_topic" value="$(arg filtered_cloud_topic)"/>
    <arg name="minimum_obstacle_z" value="0.20"/>
    <arg name="map_size_x" value="90.0"/>
    <arg name="map_size_y" value="120.0"/>
    <arg name="map_size_z" value="12.0"/>
    <arg name="map_resolution" value="0.20"/>
    <!-- Keep the worksite low-altitude planner above the mission's 2 m
         safety floor. If a confirmed 3 m horizontal passage is absent, EGO
         must climb over the obstacle instead of diving underneath it. -->
    <arg name="ground_height" value="2.0"/>
    <arg name="virtual_ceil_height" value="10.0"/>
    <arg name="max_vel" value="0.50"/>
    <arg name="max_acc" value="0.50"/>
    <arg name="planning_horizon" value="7.5"/>
    <arg name="manual_target_height" value="3.0"/>
    <arg name="use_goal_height" value="true"/>
    <!-- Keep the two-voxel hard envelope used by the low-altitude candidate
         selector. A three-voxel (0.60 m) envelope was flight-tested and
         rejected because it removed too much usable clearance near WP6. -->
    <arg name="obstacles_inflation" value="0.40"/>
  </include>

  <rosparam command="load" file="$(arg task_config)"
            ns="/ego_planner_node"/>

  <node pkg="astra_tower_mission" type="occupancy_stamp_adapter_node"
        name="occupancy_stamp_adapter" output="screen" required="true">
    <param name="input_topic" value="$(arg occupancy_topic)"/>
    <param name="output_topic" value="$(arg stamped_occupancy_topic)"/>
    <param name="planning_frame" value="camera_init"/>
  </node>

  <node pkg="astra_tower_mission" type="stage3_ego_mission_node"
        name="tower_mission" output="screen" required="true">
    <rosparam command="load" file="$(arg task_config)"/>
    <param name="enable_control" value="$(arg enable_control)"/>
    <param name="report_file" value="$(arg report_file)"/>
    <param name="topics/occupancy_inflate"
           value="$(arg stamped_occupancy_topic)"/>
  </node>
</launch>

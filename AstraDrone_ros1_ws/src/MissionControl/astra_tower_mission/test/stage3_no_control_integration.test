<launch>
  <node pkg="astra_tower_mission" type="stage3_ego_mission_node"
        name="tower_mission" output="screen" required="true">
    <rosparam command="load"
              file="$(find astra_tower_mission)/config/stage3_ego.yaml"/>
    <param name="enable_control" value="true"/>
    <param name="tower/center/x" value="0.0"/>
    <param name="tower/center/y" value="0.0"/>
    <param name="tower/collision_radius" value="2.0"/>
    <param name="mission/radius" value="8.0"/>
    <param name="mission/inspection_height" value="5.0"/>
    <rosparam param="mission/inspection_heights">[5.0, 3.0]</rosparam>
    <param name="mission/transit_height" value="4.0"/>
    <param name="mission/minimum_height" value="2.0"/>
    <param name="mission/maximum_height" value="10.0"/>
    <param name="mission/recovery_height_max" value="8.0"/>
    <param name="mission/virtual_ceil_height" value="10.0"/>
    <param name="mission/start_angle_deg" value="0.0"/>
    <param name="mission/observation_angle_deg" value="0.0"/>
    <param name="mission/observation_radius_offset" value="3.0"/>
    <param name="mission/sector_limit" value="1"/>
    <param name="mission/inspection_laps" value="1"/>
    <param name="entry_gate/minimum_radius" value="9.0"/>
    <param name="entry_gate/maximum_radius" value="16.0"/>
    <param name="entry_gate/radius" value="11.0"/>
    <param name="entry_gate/height" value="5.0"/>
    <param name="entry_gate/maximum_segment_length" value="6.0"/>
    <param name="staging/height" value="4.0"/>
    <param name="staging/climb_height_step" value="1.0"/>
    <rosparam param="staging/ascent_step_heights">[5.0]</rosparam>
    <rosparam param="layer_transition/step_heights">[3.0]</rosparam>
    <param name="coverage/unknown_ratio_limit" value="0.90"/>
    <param name="coverage/wait_timeout" value="2.0"/>
    <param name="recovery/recovery_height" value="7.0"/>
    <param name="return_egress/orbit_radius" value="12.0"/>
    <param name="return_egress/transit_height" value="7.0"/>
    <param name="failure_hold_duration" value="0.2"/>
    <param name="arrival_hold_duration" value="0.1"/>
    <param name="input_timeout" value="1.0"/>
    <param name="map_timeout" value="1.0"/>
    <param name="report_file" value="/tmp/stage3_no_control_integration.csv"/>
  </node>

  <test test-name="stage3_no_control_integration"
        pkg="astra_tower_mission"
        type="stage3_no_control_integration_test.py"
        time-limit="35.0"/>
</launch>

Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: map grid
      Plane: XY
      Plane Cell Count: 120
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 25
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.12
      Name: closed route preview
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 0
      Pose Style: Axes
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /tower_mission/route_preview
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/PoseArray
      Color: 255; 170; 0
      Enabled: true
      Head Length: 0.6
      Head Radius: 0.15
      Name: waypoint yaw
      Queue Size: 10
      Shaft Length: 1.2
      Shaft Radius: 0.08
      Shape: Arrow (Flat)
      Topic: /tower_mission/waypoint_poses
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /tower_mission/route_markers
      Name: tower and ring envelopes
      Namespaces:
        inspection_ring: true
        tower_collision_envelope: true
      Queue Size: 100
      Value: true
    - Alpha: 1
      Class: rviz/Path
      Color: 25; 85; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: actual trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /tower_mission/actual_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Axes Length: 1.2
      Axes Radius: 0.08
      Class: rviz/Pose
      Color: 255; 0; 255
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.1
      Name: current target
      Queue Size: 10
      Shaft Length: 1
      Shaft Radius: 0.05
      Shape: Arrow
      Topic: /tower_mission/current_target
      Unreliable: false
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.08
      Class: rviz/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.1
      Name: MAVROS vehicle pose
      Queue Size: 10
      Shaft Length: 1
      Shaft Radius: 0.05
      Shape: Axes
      Topic: /mavros/local_position/pose
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz/TopDownOrtho
      Name: Top-down tower route
      Near Clip Distance: 0.01
      Scale: 80
      Target Frame: map
      X: 12
      Y: 22
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1400

<?xml version="1.0"?>
<package format="2">
  <name>ego_gazebo_bridge</name>
  <version>0.1.0</version>
  <description>Simulation-only safety bridge from EGO-Planner PositionCommand to PX4 MAVROS position setpoints.</description>

  <maintainer email="maintainer@example.com">AstraDroneOpen Maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>ego_planner</exec_depend>
  <exec_depend>waypoint_generator</exec_depend>

  <export/>
</package>

<launch>
  <!--
    Reusable EGO/PX4 integration layer. Start PX4/Gazebo, MAVROS and FAST-LIO
    in their own terminals before this file. EGO's mock map and SO3 simulator
    are intentionally not included here. The filename is deliberately based on
    function rather than a roadmap stage number.
  -->
  <arg name="enable_control" default="false"/>
  <arg name="require_start_permission" default="true"/>
  <arg name="require_orbit_speed_scale" default="false"/>
  <arg name="orbit_speed_scale_topic" default="/swarm/orbit_speed_scale"/>
  <arg name="orbit_speed_scale_timeout" default="0.5"/>
  <arg name="drone_id" default="0"/>
  <arg name="auto_track_on_command" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="rviz_config"
       default="$(find ego_gazebo_bridge)/rviz/ego_gazebo_bridge.rviz"/>

  <arg name="planning_frame" default="camera_init"/>
  <arg name="mavros_frame" default="map"/>
  <arg name="odom_topic" default="/Odometry"/>
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="position_command_topic" default="planning/pos_cmd"/>
  <arg name="planner_goal_topic" default="planning/goal"/>
  <arg name="planning_cancel_topic" default="planning/cancel"/>
  <arg name="planner_bspline_topic" default="planning/bspline"/>
  <arg name="planner_status_topic" default="planner/status"/>
  <arg name="waypoint_topic" default="waypoint_generator/waypoints"/>
  <arg name="traj_start_trigger_topic" default="traj_start_trigger"/>
  <arg name="bridge_cloud_topic" default="$(arg cloud_topic)"/>
  <arg name="ego_cloud_topic" default="$(arg cloud_topic)"/>
  <arg name="filter_ground_cloud" default="false"/>
  <arg name="filtered_cloud_topic" default="/stage2/cloud_registered_filtered"/>
  <arg name="cloud_filter_diagnostic_topic"
       default="stage5/cloud_filter_diagnostics"/>
  <arg name="minimum_obstacle_z" default="0.2"/>
  <arg name="bridge_config_file"
       default="$(find ego_gazebo_bridge)/config/ego_gazebo_bridge.yaml"/>
  <arg name="override_takeoff_height" default="false"/>
  <arg name="takeoff_height" default="1.0"/>
  <arg name="return_height" default="$(arg takeoff_height)"/>

  <arg name="map_size_x" default="40.0"/>
  <arg name="map_size_y" default="40.0"/>
  <arg name="map_size_z" default="3.0"/>
  <arg name="max_vel" default="0.5"/>
  <arg name="max_acc" default="1.0"/>
  <arg name="planning_horizon" default="7.5"/>
  <arg name="manual_target_height" default="1.0"/>
  <arg name="use_goal_height" default="false"/>
  <arg name="obstacles_inflation" default="0.3"/>
  <arg name="map_resolution" default="0.1"/>
  <arg name="ground_height" default="-0.01"/>
  <arg name="virtual_ceil_height" default="2.5"/>
  <arg name="marker_namespace" default="ego_trajectory"/>
  <arg name="trajectory_color_r" default="1.0"/>
  <arg name="trajectory_color_g" default="0.0"/>
  <arg name="trajectory_color_b" default="0.0"/>
  <arg name="swarm_clearance" default="1.50"/>
  <arg name="swarm_common_frame" default="world"/>
  <arg name="swarm_origin_x" default="0.0"/>
  <arg name="swarm_origin_y" default="0.0"/>
  <arg name="swarm_origin_z" default="0.0"/>
  <arg name="swarm_origin_yaw" default="0.0"/>
  <!-- Optional interface-only EGO velocity constraint.  Its maximum is kept
       at the statically audited max_vel ceiling. -->
  <arg name="dynamic_speed_limit_enabled" default="false"/>
  <arg name="dynamic_speed_limit_topic" default="learning_speed/v_max"/>
  <arg name="dynamic_speed_limit_applied_topic"
       default="learning_speed/applied_v_max"/>
  <arg name="dynamic_speed_limit_minimum" default="0.05"/>
  <arg name="dynamic_speed_limit_replan_delta" default="0.05"/>
  <arg name="dynamic_speed_limit_replan_cooldown" default="1.0"/>

  <!--
    The Gazebo MID360/FAST-LIO stack and MAVROS local ENU start aligned in this
    simulation. The bridge still checks their live position/yaw agreement
    before it accepts EGO tracking. Override this to false when supplying a
    measured, non-identity transform.
  -->
  <arg name="publish_identity_planning_tf" default="true"/>
  <node if="$(arg publish_identity_planning_tf)"
        pkg="tf2_ros" type="static_transform_publisher"
        name="verified_map_to_planning_frame"
        args="0 0 0 0 0 0 1 $(arg mavros_frame) $(arg planning_frame)"/>

  <include file="$(find ego_planner)/launch/advanced_param.xml">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>
    <arg name="cloud_topic" value="$(arg ego_cloud_topic)"/>

    <!-- Cloud input is used; these depth-camera topics are intentionally idle. -->
    <arg name="camera_pose_topic" value="/ego_gazebo_bridge/unused_camera_pose"/>
    <arg name="depth_topic" value="/ego_gazebo_bridge/unused_depth"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>

    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="flight_type" value="1"/>
    <arg name="planning_frame" value="$(arg planning_frame)"/>
    <arg name="manual_target_height" value="$(arg manual_target_height)"/>
    <arg name="use_goal_height" value="$(arg use_goal_height)"/>
    <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="ground_height" value="$(arg ground_height)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <arg name="marker_namespace" value="$(arg marker_namespace)"/>
    <arg name="trajectory_color_r" value="$(arg trajectory_color_r)"/>
    <arg name="trajectory_color_g" value="$(arg trajectory_color_g)"/>
    <arg name="trajectory_color_b" value="$(arg trajectory_color_b)"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="swarm_common_frame" value="$(arg swarm_common_frame)"/>
    <arg name="swarm_origin_x" value="$(arg swarm_origin_x)"/>
    <arg name="swarm_origin_y" value="$(arg swarm_origin_y)"/>
    <arg name="swarm_origin_z" value="$(arg swarm_origin_z)"/>
    <arg name="swarm_origin_yaw" value="$(arg swarm_origin_yaw)"/>
    <arg name="dynamic_speed_limit_enabled"
         value="$(arg dynamic_speed_limit_enabled)"/>
    <arg name="dynamic_speed_limit_topic"
         value="$(arg dynamic_speed_limit_topic)"/>
    <arg name="dynamic_speed_limit_applied_topic"
         value="$(arg dynamic_speed_limit_applied_topic)"/>
    <arg name="dynamic_speed_limit_minimum"
         value="$(arg dynamic_speed_limit_minimum)"/>
    <arg name="dynamic_speed_limit_maximum" value="$(arg max_vel)"/>
    <arg name="dynamic_speed_limit_replan_delta"
         value="$(arg dynamic_speed_limit_replan_delta)"/>
    <arg name="dynamic_speed_limit_replan_cooldown"
         value="$(arg dynamic_speed_limit_replan_cooldown)"/>
    <!-- The EGO FSM consumes the stamped planner goal directly.  The
         waypoint-generator Path remains available for visualization but is
         not silently wired into a PoseStamped subscriber. -->
    <arg name="waypoint_topic" value="$(arg planner_goal_topic)"/>
    <arg name="cancel_topic" value="$(arg planning_cancel_topic)"/>
    <arg name="bspline_topic" value="$(arg planner_bspline_topic)"/>
    <arg name="status_topic" value="$(arg planner_status_topic)"/>

    <!-- Unused for flight_type=1; explicit values keep the include contract complete. -->
    <arg name="point_num" value="0"/>
    <arg name="point0_x" value="0.0"/>
    <arg name="point0_y" value="0.0"/>
    <arg name="point0_z" value="1.0"/>
    <arg name="point1_x" value="0.0"/>
    <arg name="point1_y" value="0.0"/>
    <arg name="point1_z" value="1.0"/>
    <arg name="point2_x" value="0.0"/>
    <arg name="point2_y" value="0.0"/>
    <arg name="point2_z" value="1.0"/>
    <arg name="point3_x" value="0.0"/>
    <arg name="point3_y" value="0.0"/>
    <arg name="point3_z" value="1.0"/>
    <arg name="point4_x" value="0.0"/>
    <arg name="point4_y" value="0.0"/>
    <arg name="point4_z" value="1.0"/>
  </include>

  <node if="$(arg filter_ground_cloud)" pkg="ego_gazebo_bridge"
        type="ground_cloud_filter" name="ground_cloud_filter"
        output="screen" required="true">
    <param name="input_topic" value="$(arg cloud_topic)"/>
    <param name="output_topic" value="$(arg filtered_cloud_topic)"/>
    <param name="frame_id" value="$(arg planning_frame)"/>
    <param name="minimum_z" value="$(arg minimum_obstacle_z)"/>
    <param name="diagnostic_topic"
           value="$(arg cloud_filter_diagnostic_topic)"/>
  </node>

  <node pkg="ego_planner" type="traj_server" name="traj_server" output="screen">
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.0"/>
    <param name="traj_server/frame_id" value="$(arg planning_frame)"/>
    <param name="traj_server/position_command_topic"
           value="$(arg position_command_topic)"/>
    <param name="traj_server/goal_topic" value="$(arg planner_goal_topic)"/>
    <param name="traj_server/cancel_topic"
           value="$(arg planning_cancel_topic)"/>
    <param name="traj_server/bspline_topic"
           value="$(arg planner_bspline_topic)"/>
  </node>

  <node pkg="waypoint_generator" type="waypoint_generator"
        name="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~goal" to="$(arg planner_goal_topic)"/>
    <remap from="~waypoints" to="$(arg waypoint_topic)"/>
    <remap from="~traj_start_trigger" to="$(arg traj_start_trigger_topic)"/>
    <param name="waypoint_type" value="manual-lonely-waypoint"/>
    <param name="frame_id" value="$(arg planning_frame)"/>
  </node>

  <node pkg="ego_gazebo_bridge" type="ego_mavros_bridge"
        name="ego_mavros_bridge" output="screen" required="true">
    <rosparam command="load" file="$(arg bridge_config_file)"/>
    <param name="enable_control" value="$(arg enable_control)"/>
    <param name="require_start_permission"
           value="$(arg require_start_permission)"/>
    <param name="require_orbit_speed_scale"
           value="$(arg require_orbit_speed_scale)"/>
    <param name="orbit_speed_scale_topic"
           value="$(arg orbit_speed_scale_topic)"/>
    <param name="orbit_speed_scale_timeout"
           value="$(arg orbit_speed_scale_timeout)"/>
    <param name="auto_track_on_command" value="$(arg auto_track_on_command)"/>
    <param name="planning_frame" value="$(arg planning_frame)"/>
    <param name="mavros_frame" value="$(arg mavros_frame)"/>
    <param name="planner_odom_topic" value="$(arg odom_topic)"/>
    <param name="cloud_topic" value="$(arg bridge_cloud_topic)"/>
    <param name="command_topic" value="$(arg position_command_topic)"/>
    <param name="planner_goal_topic" value="$(arg planner_goal_topic)"/>
    <param name="planning_cancel_topic" value="$(arg planning_cancel_topic)"/>
    <param if="$(arg override_takeoff_height)"
           name="takeoff_height" value="$(arg takeoff_height)"/>
    <param if="$(arg override_takeoff_height)"
           name="return_height" value="$(arg return_height)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="ego_gazebo_bridge_rviz"
        args="-d $(arg rviz_config) -f $(arg planning_frame)"/>
</launch>

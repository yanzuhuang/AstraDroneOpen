<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Qualification-only geometry for real Mid360 variation during Hector motion. -->
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="front_observation_cylinder">
      <static>true</static>
      <pose>4.0 0.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.50</radius><length>4.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.50</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="turn_observation_box">
      <static>true</static>
      <pose>2.0 4.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 4.0</size></box></geometry>
          <material><ambient>0.2 0.6 0.8 1</ambient><diffuse>0.2 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="side_observation_box">
      <static>true</static>
      <pose>-2.5 -1.5 1.5 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 2.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 2.0 3.0</size></box></geometry>
          <material><ambient>0.3 0.8 0.3 1</ambient><diffuse>0.3 0.8 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
  </world>
</sdf>

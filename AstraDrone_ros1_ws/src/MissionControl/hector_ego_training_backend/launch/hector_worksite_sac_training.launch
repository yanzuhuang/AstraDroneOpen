<launch>
  <!-- Training-only SAC qualification/training/evaluation; no PX4/MAVROS/FAST-LIO. -->
  <arg name="output_dir"/>
  <arg name="gui" default="false"/>
  <arg name="hover_x" default="0.0"/>
  <arg name="hover_y" default="0.0"/>
  <arg name="episode_count" default="20"/>
  <arg name="evaluation_episodes" default="100"/>
  <arg name="evaluation_fixed_vmax" default="0.0"/>
  <arg name="total_training_episodes" default="10000"/>
  <!-- Training and qualification/evaluation have separate Episode-count
       inputs; completed Episode count is the sole normal stop unit. -->
  <arg name="coordinator_episode_count"
       default="$(eval int(arg('total_training_episodes')) if arg('runner_mode') == 'training' else (int(arg('evaluation_episodes')) if arg('runner_mode') == 'evaluation' else int(arg('episode_count'))))"/>
  <arg name="v_max_min" default="0.30"/>
  <arg name="v_max_max" default="1.75"/>
  <arg name="max_episode_time" default="55.0"/>
  <arg name="run_id" default="worksite_sac_training_10000ep"/>
  <arg name="phase_a_min_transitions" default="1000"/>
  <arg name="phase_b_min_updates" default="100"/>
  <arg name="runner_mode" default="training"/>
  <!-- Training is randomized; qualification/evaluation stay at nominal Hover. -->
  <arg name="random_start_enabled"
       default="$(eval arg('runner_mode') == 'training')"/>
  <arg name="evaluation_checkpoint_path" default=""/>
  <arg name="evaluation_checkpoint_episode" default="0"/>
  <arg name="sac_config"
       default="$(find learning_speed_rl)/config/sac_training_v1.yaml"/>
  <arg name="reward_config"
       default="$(find learning_speed_rl)/config/stage1_reward.yaml"/>

  <include file="$(find hector_ego_training_backend)/launch/hector_worksite_training_episode_reset.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="hover_x" value="$(arg hover_x)"/>
    <arg name="hover_y" value="$(arg hover_y)"/>
    <arg name="episode_count" value="$(arg coordinator_episode_count)"/>
    <arg name="runner_mode" value="$(arg runner_mode)"/>
    <arg name="fixed_v_max" value="$(arg v_max_max)"/>
    <arg name="v_max_min" value="$(arg v_max_min)"/>
    <arg name="static_max_vel" value="4.00"/>
    <arg name="static_max_acc" value="3.00"/>
    <arg name="action_owner" value="sac"/>
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="require_automated_acceptance" value="false"/>
    <arg name="coordinator_required" value="false"/>
    <arg name="max_episode_time" value="$(arg max_episode_time)"/>
    <arg name="random_start_enabled" value="$(arg random_start_enabled)"/>
  </include>

  <group ns="uav1">
    <node pkg="learning_speed_rl" type="sac_training_runner.py"
          name="sac_training_runner" output="screen" required="true">
      <rosparam command="load" file="$(arg sac_config)"/>
      <rosparam command="load" file="$(arg reward_config)"/>
      <param name="namespace" value="uav1"/>
      <param name="run_id" value="$(arg run_id)"/>
      <param name="output_dir" value="$(arg output_dir)"/>
      <param name="training/mode" value="$(arg runner_mode)"/>
      <param name="training/total_training_episodes"
             value="$(arg total_training_episodes)"/>
      <param name="environment/reset_randomization_enabled"
             value="$(arg random_start_enabled)"/>
      <param name="evaluation/fixed_vmax" value="$(arg evaluation_fixed_vmax)"/>
      <param name="evaluation/checkpoint_path"
             value="$(arg evaluation_checkpoint_path)"/>
      <param name="evaluation/checkpoint_episode"
             value="$(arg evaluation_checkpoint_episode)"/>
      <param name="evaluation/episode_count"
             value="$(arg evaluation_episodes)"/>
      <param name="qualification/episode_count" value="$(arg episode_count)"/>
      <param name="qualification/phase_a_min_transitions"
             value="$(arg phase_a_min_transitions)"/>
      <param name="qualification/phase_b_min_updates"
             value="$(arg phase_b_min_updates)"/>
      <param name="action/expected_v_max_max" value="$(arg v_max_max)"/>
      <param name="action/expected_v_max_min" value="$(arg v_max_min)"/>
    </node>
  </group>
</launch>

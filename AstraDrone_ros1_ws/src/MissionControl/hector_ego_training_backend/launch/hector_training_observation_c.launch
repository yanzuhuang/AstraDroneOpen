<launch>
  <!-- Explicit training-only profile: no PX4, MAVROS, FAST-LIO or bridge. -->
  <arg name="enable_control" default="false"/>
  <arg name="run_qualification" default="false"/>
  <arg name="qualification_output_dir" default=""/>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="fixed_v_max" default="0.30"/>
  <arg name="v_max_min" default="0.30"/>
  <arg name="static_max_vel" default="4.00"/>
  <arg name="static_max_acc" default="3.00"/>
  <arg name="speed_policy_mode" default="fixed"/>
  <arg name="mock_request_driven" default="false"/>
  <arg name="coordinator_managed_goals" default="false"/>
  <arg name="world_name"
       default="$(find hector_ego_training_backend)/worlds/training_observation_validation.world"/>
  <arg name="hover_x" default="0.0"/>
  <arg name="hover_y" default="0.0"/>
  <arg name="hover_z" default="1.5"/>
  <arg name="hover_yaw" default="0.0"/>
  <arg name="ego_cloud_topic" default="qualification/cloud"/>
  <arg name="start_truth_cloud_registration" default="false"/>
  <arg name="truth_cloud_config"
       default="$(find hector_ego_training_backend)/config/truth_cloud_registration.yaml"/>
  <arg name="spawn_wall_delay" default="0.0"/>
  <arg name="map_size_x" default="20.0"/>
  <arg name="map_size_y" default="20.0"/>
  <arg name="map_size_z" default="4.0"/>
  <!-- Qualification injection seam only.  The default keeps the production
       Observation C trajectory source unchanged. -->
  <arg name="observation_trajectory_topic" default="planning/bspline"/>
  <!-- Diagnostic/reference metadata only.  The actual training sensor rate is
       owned by quadrotor_mid360_training.gazebo.xacro. -->
  <arg name="cloud_rate_reference_hz" default="15.0"/>

  <include file="$(find hector_ego_training_backend)/launch/hector_ego_training_backend.launch">
    <arg name="enable_control" value="$(arg enable_control)"/>
    <arg name="run_qualification" value="$(arg run_qualification)"/>
    <arg name="qualification_output_dir" value="$(arg qualification_output_dir)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="model_xacro"
         value="$(find hector_ego_training_backend)/urdf/quadrotor_mid360_training.gazebo.xacro"/>
    <arg name="dynamic_speed_limit_enabled" value="true"/>
    <arg name="dynamic_speed_limit_minimum" value="$(arg v_max_min)"/>
    <arg name="max_vel" value="$(arg static_max_vel)"/>
    <arg name="max_acc" value="$(arg static_max_acc)"/>
    <arg name="require_training_observation_c" value="true"/>
    <arg name="qualification_required" value="true"/>
    <arg name="coordinator_managed_goals"
         value="$(arg coordinator_managed_goals)"/>
    <arg name="hover_x" value="$(arg hover_x)"/>
    <arg name="hover_y" value="$(arg hover_y)"/>
    <arg name="hover_z" value="$(arg hover_z)"/>
    <arg name="hover_yaw" value="$(arg hover_yaw)"/>
    <arg name="ego_cloud_topic" value="$(arg ego_cloud_topic)"/>
    <arg name="spawn_wall_delay" value="$(arg spawn_wall_delay)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
  </include>

  <group ns="uav1" if="$(arg start_truth_cloud_registration)">
    <node pkg="hector_ego_training_backend"
          type="truth_cloud_registration_adapter.py"
          name="truth_cloud_registration_adapter"
          output="screen" required="true">
      <rosparam command="load" file="$(arg truth_cloud_config)"/>
    </node>
  </group>

  <include file="$(find learning_speed_rl)/launch/speed_adapter.launch">
    <arg name="namespace" value="uav1"/>
    <arg name="static_max_vel" value="$(arg static_max_vel)"/>
    <arg name="static_min_vel" value="$(arg v_max_min)"/>
    <arg name="fixed_v_max" value="$(arg fixed_v_max)"/>
    <arg name="policy_mode" value="$(arg speed_policy_mode)"/>
    <arg name="mock_request_driven" value="$(arg mock_request_driven)"/>
    <arg name="odom_topic" value="Odometry"/>
    <arg name="occupancy_topic" value="qualification/cloud"/>
    <arg name="position_command_topic" value="planning/pos_cmd"/>
    <arg name="local_goal_topic" value="planning/goal"/>
  </include>

  <include file="$(find learning_speed_rl)/launch/observation_c_trajectory_fusion.launch">
    <arg name="namespace" value="uav1"/>
    <arg name="cloud_topic" value="livox/lidar"/>
    <arg name="odom_topic" value="Odometry"/>
    <arg name="trajectory_topic" value="$(arg observation_trajectory_topic)"/>
    <arg name="ego_applied_v_max_topic" value="learning_speed/applied_v_max"/>
    <arg name="world_frame" value="world"/>
    <arg name="body_frame" value="base_link"/>
    <arg name="sensor_frame" value="mid360_link"/>
    <arg name="state_source_type" value="gazebo_truth_training"/>
    <arg name="state_contract_version"
         value="astradrone_training_odometry_v1.0"/>
    <arg name="state_lookup_policy" value="causal_at_or_before"/>
    <arg name="require_lidar_state_provenance" value="true"/>
    <arg name="cloud_frame_mode" value="sensor_raw"/>
    <arg name="v2_pose_lookup_policy" value="causal_at_or_before"/>
    <arg name="sensor_translation_x" value="0.0"/>
    <arg name="sensor_translation_y" value="0.0"/>
    <arg name="sensor_translation_z" value="0.13"/>
    <arg name="cloud_rate_reference_hz"
         value="$(arg cloud_rate_reference_hz)"/>
  </include>
</launch>

<launch>
  <!-- Explicit training-only profile: no PX4, MAVROS, FAST-LIO or bridge. -->
  <arg name="enable_control" default="false"/>
  <arg name="run_qualification" default="false"/>
  <arg name="qualification_output_dir" default=""/>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="fixed_v_max" default="0.40"/>

  <include file="$(find hector_ego_training_backend)/launch/hector_ego_training_backend.launch">
    <arg name="enable_control" value="$(arg enable_control)"/>
    <arg name="run_qualification" value="$(arg run_qualification)"/>
    <arg name="qualification_output_dir" value="$(arg qualification_output_dir)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="world_name"
         value="$(find hector_ego_training_backend)/worlds/training_observation_validation.world"/>
    <arg name="model_xacro"
         value="$(find hector_ego_training_backend)/urdf/quadrotor_mid360_training.gazebo.xacro"/>
    <arg name="dynamic_speed_limit_enabled" value="true"/>
    <arg name="require_training_observation_c" value="true"/>
    <arg name="qualification_required" value="true"/>
  </include>

  <include file="$(find learning_speed_rl)/launch/speed_adapter.launch">
    <arg name="namespace" value="uav1"/>
    <arg name="static_max_vel" value="$(arg fixed_v_max)"/>
    <arg name="fixed_v_max" value="$(arg fixed_v_max)"/>
    <arg name="policy_mode" value="fixed"/>
    <arg name="odom_topic" value="Odometry"/>
    <arg name="occupancy_topic" value="qualification/cloud"/>
    <arg name="position_command_topic" value="planning/pos_cmd"/>
    <arg name="local_goal_topic" value="planning/goal"/>
  </include>

  <include file="$(find learning_speed_rl)/launch/observation_c_trajectory_fusion.launch">
    <arg name="namespace" value="uav1"/>
    <arg name="cloud_topic" value="livox/lidar"/>
    <arg name="odom_topic" value="Odometry"/>
    <arg name="trajectory_topic" value="planning/bspline"/>
    <arg name="ego_applied_v_max_topic" value="learning_speed/applied_v_max"/>
    <arg name="world_frame" value="world"/>
    <arg name="body_frame" value="base_link"/>
    <arg name="sensor_frame" value="mid360_link"/>
    <arg name="state_source_type" value="gazebo_truth_training"/>
    <arg name="state_contract_version"
         value="astradrone_training_odometry_v1.0"/>
    <arg name="state_lookup_policy" value="causal_at_or_before"/>
    <arg name="require_lidar_state_provenance" value="true"/>
    <arg name="cloud_frame_mode" value="sensor_raw"/>
    <arg name="v2_pose_lookup_policy" value="causal_at_or_before"/>
    <arg name="sensor_translation_x" value="0.0"/>
    <arg name="sensor_translation_y" value="0.0"/>
    <arg name="sensor_translation_z" value="0.13"/>
  </include>
</launch>

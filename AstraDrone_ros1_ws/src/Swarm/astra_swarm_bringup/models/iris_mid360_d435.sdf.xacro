<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Common dual-vehicle sensor model. The numbered PX4 airframe remains an
    argument because its MAVLink ports and airframe startup are version-locked.
    Mid360 and D435 geometry/plugins are instantiated here so adding a vehicle
    does not require another copied sensor model.
  -->
  <xacro:arg name="uav_id" default="1"/>
  <xacro:arg name="model_name" default="uav1"/>
  <xacro:arg name="base_model" default="iris_without_GPS_0"/>
  <xacro:arg name="robot_namespace" default="/uav1"/>
  <xacro:arg name="frame_prefix" default="uav1"/>
  <xacro:arg name="gazebo_camera_name" default="UAV1_Camera"/>
  <xacro:arg name="camera_namespace" default="/uav1/d435"/>
  <xacro:arg name="lidar_namespace" default="/uav1/livox"/>
  <xacro:arg name="lidar_downsample" default="1"/>
  <xacro:arg name="d435_enabled" default="true"/>

  <xacro:property name="uav_id" value="$(arg uav_id)"/>
  <xacro:property name="model_name" value="$(arg model_name)"/>
  <xacro:property name="base_model" value="$(arg base_model)"/>
  <xacro:property name="robot_namespace" value="$(arg robot_namespace)"/>
  <xacro:property name="frame_prefix" value="$(arg frame_prefix)"/>
  <xacro:property name="gazebo_camera_name"
                  value="$(arg gazebo_camera_name)"/>
  <xacro:property name="camera_namespace" value="$(arg camera_namespace)"/>
  <xacro:property name="lidar_namespace" value="$(arg lidar_namespace)"/>
  <xacro:property name="d435_sensor_prefix"
                  value="${gazebo_camera_name}_"/>

  <model name="${model_name}">
    <include>
      <uri>model://${base_model}</uri>
    </include>

    <!-- MID360: values are identical to the validated single-vehicle model. -->
    <link name="mid360_link">
      <pose>0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <pose>0 0 0 0 0 3.1415</pose>
        <geometry>
          <mesh>
            <uri>model://mid360/meshes/livox_mid-360-90x.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <pose>0 0 0 0 0 3.1415</pose>
        <geometry>
          <mesh>
            <uri>model://mid360/meshes/livox_mid-360-90x.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <sensor type="ray" name="laser_livox">
        <pose>0 0 0.05 0 0 0</pose>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <plugin name="gazebo_ros_laser_controller"
                filename="liblivox_laser_simulation.so">
          <robotNamespace>${lidar_namespace}</robotNamespace>
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </horizontal>
              <vertical>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.2</min>
              <max>40</max>
              <resolution>1</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0</stddev>
            </noise>
          </ray>
          <visualize>true</visualize>
          <samples>20000</samples>
          <downsample>$(arg lidar_downsample)</downsample>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>3</publish_pointcloud_type>
          <ros_topic>${lidar_namespace}/lidar</ros_topic>
          <frameName>${frame_prefix}/mid360_link</frameName>
        </plugin>
      </sensor>

      <sensor name="mid360_imu_sensor" type="imu">
        <pose>-0.011 -0.02329 0.04412 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <noise>
            <type>gaussian</type>
            <rate>
              <mean>0</mean>
              <stddev>0.00017</stddev>
              <bias_mean>0</bias_mean>
              <bias_stddev>0.00001</bias_stddev>
            </rate>
            <accel>
              <mean>0</mean>
              <stddev>0.017</stddev>
              <bias_mean>0</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </accel>
          </noise>
        </imu>
        <plugin name="mid360_imu_plugin"
                filename="libgazebo_ros_imu_sensor.so">
          <robotNamespace>${lidar_namespace}</robotNamespace>
          <topicName>imu</topicName>
          <bodyName>mid360_link</bodyName>
          <updateRateHZ>200</updateRateHZ>
          <gaussianNoise>0</gaussianNoise>
          <xyzOffset>-0.011 -0.02329 0.04412</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>${frame_prefix}/mid360_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>
    </link>
    <joint name="mid360_joint" type="fixed">
      <parent>${base_model}::base_link</parent>
      <child>mid360_link</child>
    </joint>

    <!--
      D435 physical mount and optical parameters are copied from the stable
      single-vehicle iris_mid360 + D435i model:
        mount pose = 0.12 0 0.03 1.57 0 1.57
        RGB HFOV = 1.211; depth/IR HFOV = 1.571
        640x480 @ 30 Hz; near/far = 0.1/100 m
    -->
    <link name="d435_link">
      <pose>0.12 0 0.03 1.57 0 1.57</pose>
      <inertial>
        <!-- Camera body plus the five 1.5 g child links in the source model. -->
        <mass>0.0639</mass>
        <inertia>
          <ixx>4.1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.9e-06</iyy>
          <iyz>0</iyz>
          <izz>5.9e-06</izz>
        </inertia>
      </inertial>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <gravity>true</gravity>
      <visual name="d435_visual">
        <geometry>
          <mesh>
            <uri>model://D435i/meshes/D435i.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="d435_collision">
        <geometry>
          <box>
            <size>0.02505 0.090 0.025</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- The current tower planner uses Mid360/FAST-LIO, not D435.  Keep the
           camera enabled by default, but allow a launch to omit only its
           sensors/plugins when the host rendering stack cannot initialize
           the Realsense Gazebo plugin.  The physical mount and TF contract
           remain present in both variants. -->
      <xacro:if value="$(arg d435_enabled)">
      <sensor name="${d435_sensor_prefix}imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <plugin name="${d435_sensor_prefix}imu_plugin"
                filename="libgazebo_ros_imu_sensor.so">
          <robotNamespace>${camera_namespace}</robotNamespace>
          <topicName>imu</topicName>
          <bodyName>d435_link</bodyName>
          <updateRateHZ>100</updateRateHZ>
          <gaussianNoise>0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>${frame_prefix}/d435_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>

      <sensor name="${d435_sensor_prefix}color" type="camera">
        <pose>0.0325 0 0 3.14 -1.57 1.57</pose>
        <camera name="${gazebo_camera_name}_color">
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>

      <sensor name="${d435_sensor_prefix}ired1" type="camera">
        <pose>0.02 0 0 3.14 -1.57 1.57</pose>
        <camera name="${gazebo_camera_name}_infra1">
          <horizontal_fov>1.571</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <sensor name="${d435_sensor_prefix}ired2" type="camera">
        <pose>-0.03 0 0 3.14 -1.57 1.57</pose>
        <camera name="${gazebo_camera_name}_infra2">
          <horizontal_fov>1.571</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <sensor name="${d435_sensor_prefix}depth" type="depth">
        <pose>0.0325 0 0 3.14 -1.57 1.57</pose>
        <camera name="${gazebo_camera_name}_depth">
          <horizontal_fov>1.571</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
      </xacro:if>
    </link>
    <joint name="d435_mount_joint" type="fixed">
      <parent>${base_model}::base_link</parent>
      <child>d435_link</child>
    </joint>

    <xacro:if value="$(arg d435_enabled)">
    <plugin name="${gazebo_camera_name}_plugin"
            filename="librealsense_gazebo_plugin.so">
      <prefix>${d435_sensor_prefix}</prefix>
      <depthUpdateRate>30</depthUpdateRate>
      <colorUpdateRate>30</colorUpdateRate>
      <infraredUpdateRate>30</infraredUpdateRate>
      <depthTopicName>depth/image_raw</depthTopicName>
      <depthCameraInfoTopicName>depth/camera_info</depthCameraInfoTopicName>
      <colorTopicName>color/image_raw</colorTopicName>
      <colorCameraInfoTopicName>color/camera_info</colorCameraInfoTopicName>
      <infrared1TopicName>infra1/image_raw</infrared1TopicName>
      <infrared1CameraInfoTopicName>infra1/camera_info</infrared1CameraInfoTopicName>
      <infrared2TopicName>infra2/image_raw</infrared2TopicName>
      <infrared2CameraInfoTopicName>infra2/camera_info</infrared2CameraInfoTopicName>
      <colorOpticalframeName>${frame_prefix}/d435_color_optical_frame</colorOpticalframeName>
      <depthOpticalframeName>${frame_prefix}/d435_depth_optical_frame</depthOpticalframeName>
      <infrared1OpticalframeName>${frame_prefix}/d435_infra1_optical_frame</infrared1OpticalframeName>
      <infrared2OpticalframeName>${frame_prefix}/d435_infra2_optical_frame</infrared2OpticalframeName>
      <rangeMinDepth>0.2</rangeMinDepth>
      <rangeMaxDepth>10</rangeMaxDepth>
      <pointCloud>false</pointCloud>
      <pointCloudTopicName>depth/color/points</pointCloudTopicName>
      <pointCloudCutoff>0.25</pointCloudCutoff>
      <pointCloudCutoffMax>9</pointCloudCutoffMax>
      <!-- Keep last: the upstream parser treats this as its terminator. -->
      <robotNamespace>${camera_namespace}</robotNamespace>
    </plugin>
    </xacro:if>
  </model>
</sdf>

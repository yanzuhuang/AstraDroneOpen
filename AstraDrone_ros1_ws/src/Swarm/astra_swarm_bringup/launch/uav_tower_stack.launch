<launch>
  <arg name="uav_ns"/>
  <arg name="uav_id"/>
  <arg name="planner_drone_id" default="0"/>
  <arg name="enable_control" default="false"/>
  <arg name="mission_enabled" default="true"/>
  <arg name="require_start_permission" default="true"/>
  <arg name="takeoff_delay" default="0.0"/>
  <arg name="planning_frame"/>
  <arg name="mavros_frame"/>
  <arg name="inspection_top_height"/>
  <arg name="layer_offsets" default="[0.0, -4.0]"/>
  <arg name="takeoff_height" default="4.0"/>
  <arg name="staging_height" default="$(arg takeoff_height)"/>
  <arg name="ascent_intermediate_heights" default="[]"/>
  <arg name="entry_sector" default="7"/>
  <arg name="entry_angle_deg"
       default="$(eval (float(arg('entry_sector')) - 1.0) * 45.0)"/>
  <arg name="pre_entry_radius" default="18.0"/>
  <arg name="entry_target_timeout" default="120.0"/>
  <arg name="inspection_laps" default="1"/>
  <arg name="mission_overall_timeout" default="1200.0"/>
  <arg name="low_altitude_enabled" default="false"/>
  <arg name="low_altitude_floor_height" default="1.6"/>
  <arg name="low_altitude_ceiling_height" default="3.0"/>
  <arg name="coordination_enabled" default="true"/>
  <arg name="orbit_permission_enabled" default="false"/>
  <arg name="orbit_speed_scale_enabled" default="false"/>
  <arg name="learning_speed_enabled" default="false"/>
  <arg name="learning_speed_config"
       default="$(find learning_speed_rl)/config/speed_adapter.yaml"/>
  <arg name="learning_speed_policy_mode" default="mock"/>
  <arg name="learning_speed_mock_request_driven" default="false"/>
  <arg name="learning_speed_fixed_v_max" default="$(arg max_vel)"/>
  <arg name="learning_speed_v_max_min" default="0.05"/>
  <arg name="task_config"
       default="$(find astra_tower_mission)/config/sector_inspection.yaml"/>
  <arg name="low_altitude_ego_config"
       default="$(find astra_swarm_bringup)/config/swarm_low_altitude_ego.yaml"/>
  <arg name="map_size_z" default="46.0"/>
  <arg name="map_size_x" default="90.0"/>
  <arg name="map_size_y" default="120.0"/>
  <arg name="map_resolution" default="0.20"/>
  <arg name="ground_height" default="-0.50"/>
  <arg name="virtual_ceil_height" default="45.0"/>
  <arg name="mission_maximum_height" default="45.0"/>
  <arg name="mission_minimum_height" default="2.0"/>
  <arg name="candidate_height_offsets" default="[0.0, -1.0, -2.0]"/>
  <arg name="max_vel" default="0.30"/>
  <arg name="max_acc" default="0.50"/>
  <arg name="planning_horizon" default="7.5"/>
  <arg name="obstacles_inflation" default="0.40"/>
  <arg name="swarm_clearance" default="1.50"/>
  <arg name="prefer_clear_straight_corridor" default="false"/>
  <arg name="swarm_common_frame" default="world"/>
  <arg name="swarm_origin_x" default="0.0"/>
  <arg name="swarm_origin_y" default="0.0"/>
  <arg name="swarm_origin_z" default="0.0"/>
  <arg name="swarm_origin_yaw" default="0.0"/>
  <arg name="tower_center_x"/>
  <arg name="tower_center_y" default="19.7104"/>
  <arg name="worksite_crane_x"
       default="$(eval 6.36257 - float(arg('swarm_origin_x')))"/>
  <arg name="worksite_crane_y"
       default="$(eval 21.7297 - float(arg('swarm_origin_y')))"/>
  <arg name="telephone_pole_west_x"
       default="$(eval -21.958 - float(arg('swarm_origin_x')))"/>
  <arg name="telephone_pole_west_y"
       default="$(eval 19.0 - float(arg('swarm_origin_y')))"/>
  <arg name="telephone_pole_southwest_x"
       default="$(eval -21.8672 - float(arg('swarm_origin_x')))"/>
  <arg name="telephone_pole_southwest_y"
       default="$(eval 10.0 - float(arg('swarm_origin_y')))"/>
  <arg name="telephone_pole_northwest_x"
       default="$(eval -22.0129 - float(arg('swarm_origin_x')))"/>
  <arg name="telephone_pole_northwest_y"
       default="$(eval 28.0 - float(arg('swarm_origin_y')))"/>
  <arg name="crane_center_x"/>
  <arg name="bridge_config"/>
  <arg name="report_file"/>
  <arg name="trajectory_color_r" default="1.0"/>
  <arg name="trajectory_color_g" default="0.0"/>
  <arg name="trajectory_color_b" default="0.0"/>

  <group ns="$(arg uav_ns)">
    <!-- GridMap still exposes vendor absolute names. Planner-owned goal,
         cancel, status, waypoint and B-spline interfaces are relative and
         therefore inherit this group namespace directly. -->
    <remap from="/grid_map/occupancy"
           to="/$(arg uav_ns)/grid_map/occupancy"/>
    <remap from="/grid_map/occupancy_inflate"
           to="/$(arg uav_ns)/grid_map/occupancy_inflate"/>
    <remap from="/grid_map/unknown"
           to="/$(arg uav_ns)/grid_map/unknown"/>
    <include file="$(find ego_gazebo_bridge)/launch/ego_gazebo_bridge.launch">
      <arg name="enable_control" value="$(arg enable_control)"/>
      <arg name="require_start_permission"
           value="$(arg require_start_permission)"/>
      <arg name="require_orbit_speed_scale"
           value="$(arg orbit_speed_scale_enabled)"/>
      <arg name="orbit_speed_scale_topic"
           value="/$(arg uav_ns)/swarm/orbit_speed_scale"/>
      <arg name="drone_id" value="$(arg planner_drone_id)"/>
      <arg name="auto_track_on_command" value="false"/>
      <arg name="rviz" value="false"/>
      <arg name="bridge_config_file" value="$(arg bridge_config)"/>
      <arg name="override_takeoff_height" value="true"/>
      <arg name="takeoff_height" value="$(arg takeoff_height)"/>
      <arg name="return_height" value="$(arg takeoff_height)"/>
      <arg name="planning_frame" value="$(arg planning_frame)"/>
      <arg name="mavros_frame" value="$(arg mavros_frame)"/>
      <arg name="odom_topic" value="/$(arg uav_ns)/Odometry"/>
      <arg name="cloud_topic"
           value="/$(arg uav_ns)/cloud_registered_self_filtered"/>
      <arg name="bridge_cloud_topic"
           value="/$(arg uav_ns)/stage3/cloud_registered_filtered"/>
      <arg name="ego_cloud_topic"
           value="/$(arg uav_ns)/stage3/cloud_registered_filtered"/>
      <arg name="filter_ground_cloud" value="true"/>
      <arg name="filtered_cloud_topic"
           value="/$(arg uav_ns)/stage3/cloud_registered_filtered"/>
      <arg name="minimum_obstacle_z" value="0.20"/>
      <arg name="position_command_topic"
           value="planning/pos_cmd"/>
      <arg name="planner_goal_topic"
           value="planning/goal"/>
      <arg name="planning_cancel_topic" value="planning/cancel"/>
      <arg name="planner_bspline_topic" value="planning/bspline"/>
      <arg name="planner_status_topic" value="planner/status"/>
      <arg name="waypoint_topic" value="waypoint_generator/waypoints"/>
      <arg name="traj_start_trigger_topic"
           value="traj_start_trigger"/>
      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="map_resolution" value="$(arg map_resolution)"/>
      <arg name="ground_height" value="$(arg ground_height)"/>
      <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
      <arg name="max_vel" value="$(arg max_vel)"/>
      <arg name="max_acc" value="$(arg max_acc)"/>
      <arg name="planning_horizon" value="$(arg planning_horizon)"/>
      <arg name="manual_target_height" value="$(arg inspection_top_height)"/>
      <arg name="use_goal_height" value="true"/>
      <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
      <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
      <arg name="swarm_common_frame" value="$(arg swarm_common_frame)"/>
      <arg name="swarm_origin_x" value="$(arg swarm_origin_x)"/>
      <arg name="swarm_origin_y" value="$(arg swarm_origin_y)"/>
      <arg name="swarm_origin_z" value="$(arg swarm_origin_z)"/>
      <arg name="swarm_origin_yaw" value="$(arg swarm_origin_yaw)"/>
      <arg name="marker_namespace"
           value="$(arg uav_ns)_ego_trajectory"/>
      <arg name="trajectory_color_r" value="$(arg trajectory_color_r)"/>
      <arg name="trajectory_color_g" value="$(arg trajectory_color_g)"/>
      <arg name="trajectory_color_b" value="$(arg trajectory_color_b)"/>
      <arg name="dynamic_speed_limit_enabled"
           value="$(arg learning_speed_enabled)"/>
      <arg name="dynamic_speed_limit_topic"
           value="learning_speed/action_stamped"/>
      <arg name="dynamic_speed_limit_applied_topic"
           value="learning_speed/applied_v_max"/>
      <arg name="dynamic_speed_limit_applied_stamped_topic"
           value="learning_speed/applied_v_max_stamped"/>
      <arg name="dynamic_speed_limit_minimum"
           value="$(arg learning_speed_v_max_min)"/>
    </include>

    <node pkg="astra_tower_mission" type="occupancy_stamp_adapter_node"
          name="occupancy_stamp_adapter" output="screen" required="true">
      <param name="input_topic"
             value="/$(arg uav_ns)/drone_$(arg planner_drone_id)_ego_planner_node/grid_map/occupancy_inflate"/>
      <param name="output_topic"
             value="/$(arg uav_ns)/stage3/occupancy_inflate"/>
      <param name="planning_frame" value="$(arg planning_frame)"/>
    </node>

    <!-- Opt-in only.  The adapter reads existing planner/state interfaces and
         publishes one scalar constraint; it has no mission or control output. -->
    <node if="$(arg learning_speed_enabled)" pkg="learning_speed_rl"
          type="speed_adapter_node.py" name="speed_adapter"
          output="screen" required="true">
      <rosparam command="load" file="$(arg learning_speed_config)"/>
      <param name="safety/v_max_max" value="$(arg max_vel)"/>
      <param name="safety/initial_v_max"
             value="$(arg learning_speed_fixed_v_max)"/>
      <param name="policy/mode" value="$(arg learning_speed_policy_mode)"/>
      <param name="timing/mock_request_driven"
             value="$(arg learning_speed_mock_request_driven)"/>
      <param name="policy/fixed_v_max"
             value="$(arg learning_speed_fixed_v_max)"/>
      <param name="policy/mock_default_v_max" value="$(arg max_vel)"/>
      <param name="topics/odom" value="Odometry"/>
      <param name="topics/occupancy" value="stage3/occupancy_inflate"/>
      <param name="topics/position_command" value="planning/pos_cmd"/>
      <param name="topics/local_goal" value="move_base_simple/goal"/>
    </node>

    <rosparam if="$(arg low_altitude_enabled)" command="load"
              file="$(arg low_altitude_ego_config)"
              ns="drone_$(arg planner_drone_id)_ego_planner_node"/>
    <param if="$(arg low_altitude_enabled)"
           name="drone_$(arg planner_drone_id)_ego_planner_node/fsm/manual_target_height"
           value="$(arg inspection_top_height)"/>
    <param if="$(arg low_altitude_enabled)"
           name="drone_$(arg planner_drone_id)_ego_planner_node/grid_map/ground_height"
           value="$(arg low_altitude_floor_height)"/>
    <param if="$(arg low_altitude_enabled)"
           name="drone_$(arg planner_drone_id)_ego_planner_node/grid_map/virtual_ceil_height"
           value="$(arg low_altitude_ceiling_height)"/>

    <node if="$(arg mission_enabled)"
          pkg="astra_tower_mission" type="sector_inspection_mission_node"
          name="tower_mission" output="screen" required="true">
      <rosparam command="load"
                file="$(arg task_config)"/>
      <param name="enable_control" value="$(arg enable_control)"/>
      <param name="uav_id" value="$(arg uav_id)"/>
      <param name="takeoff_delay" value="$(arg takeoff_delay)"/>
      <param name="planning_frame" value="$(arg planning_frame)"/>
      <param name="report_file" value="$(arg report_file)"/>
      <param name="fsm/manual_target_height"
             value="$(arg inspection_top_height)"/>
      <param name="mission/inspection_top_height"
             value="$(arg inspection_top_height)"/>
      <rosparam param="mission/layer_offsets"
                subst_value="true">$(arg layer_offsets)</rosparam>
      <param name="mission/transit_height" value="$(arg takeoff_height)"/>
      <param name="staging/height" value="$(arg staging_height)"/>
      <rosparam param="staging/ascent_intermediate_heights"
                subst_value="true">$(arg ascent_intermediate_heights)</rosparam>
      <param name="mission/maximum_height"
             value="$(arg mission_maximum_height)"/>
      <param name="mission/minimum_height"
             value="$(arg mission_minimum_height)"/>
      <rosparam param="candidate/height_offsets_m"
                subst_value="true">$(arg candidate_height_offsets)</rosparam>
      <!-- The task's YAML candidate grid is shared by the first orbit point and
           every numbered sector: nominal radius, then outward same-sector
           alternatives. Do not replace it with a swarm-only radial policy. -->
      <rosparam param="candidate/radius_offsets_m">
        [0.0, 2.0, 4.0]
      </rosparam>
      <param name="candidate/prefer_clear_straight_corridor"
             value="$(arg prefer_clear_straight_corridor)"/>
      <!-- The vendor grid is fixed about the local planning-frame origin.
           Give the task the same bounds so an orbit can never be accepted
           when its planning-horizon envelope extends outside that grid. -->
      <param name="planner_map/size_x" value="$(arg map_size_x)"/>
      <param name="planner_map/size_y" value="$(arg map_size_y)"/>
      <param name="planner_map/planning_horizon"
             value="$(arg planning_horizon)"/>
      <param name="mission/virtual_ceil_height"
             value="$(arg virtual_ceil_height)"/>
      <param name="low_altitude/enabled"
             value="$(arg low_altitude_enabled)"/>
      <param name="low_altitude/entry_height"
             value="$(arg inspection_top_height)"/>
      <param name="entry_gate/entry_sector" value="$(arg entry_sector)"/>
      <param name="entry_gate/angle_deg" value="$(arg entry_angle_deg)"/>
      <param name="entry_gate/pre_entry_radius"
             value="$(arg pre_entry_radius)"/>
      <param name="entry_gate/target_timeout"
             value="$(arg entry_target_timeout)"/>
      <param name="mission/direction" value="counter_clockwise"/>
      <param name="mission/inspection_laps" value="$(arg inspection_laps)"/>
      <param name="overall_timeout" value="$(arg mission_overall_timeout)"/>
      <param name="tower/frame_id" value="$(arg mavros_frame)"/>
      <param name="tower/center/x" value="$(arg tower_center_x)"/>
      <param name="tower/center/y" value="$(arg tower_center_y)"/>
      <rosparam unless="$(arg low_altitude_enabled)"
                param="static_obstacles/x"
                subst_value="true">[$(arg crane_center_x)]</rosparam>
      <!-- Gazebo Classic applies the <state> poses in worksite.world.  Stamp
           the measured crane and three live pole envelopes into task-level
           candidate validation as a conservative supplement to each UAV's
           independent live map. -->
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/names">
        [worksite_crane, telephone_pole_west, telephone_pole_southwest, telephone_pole_northwest]
      </rosparam>
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/x" subst_value="true">
        [$(arg worksite_crane_x), $(arg telephone_pole_west_x), $(arg telephone_pole_southwest_x), $(arg telephone_pole_northwest_x)]
      </rosparam>
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/y" subst_value="true">
        [$(arg worksite_crane_y), $(arg telephone_pole_west_y), $(arg telephone_pole_southwest_y), $(arg telephone_pole_northwest_y)]
      </rosparam>
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/z">[0.0, 0.0, 0.0, 0.0]</rosparam>
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/radius">[3.70, 0.10, 0.10, 0.10]</rosparam>
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/z_min">[-0.50, -0.50, -0.50, -0.50]</rosparam>
      <rosparam if="$(arg low_altitude_enabled)"
                param="static_obstacles/z_max">[50.0, 8.70, 8.70, 8.70]</rosparam>
      <param name="topics/odom" value="/$(arg uav_ns)/Odometry"/>
      <param name="topics/command"
             value="/$(arg uav_ns)/planning/pos_cmd"/>
      <param name="topics/cloud"
             value="/$(arg uav_ns)/stage3/cloud_registered_filtered"/>
      <param name="topics/occupancy_inflate"
             value="/$(arg uav_ns)/stage3/occupancy_inflate"/>
      <param name="topics/planner_status"
             value="/$(arg uav_ns)/planner/status"/>
      <param name="topics/bridge_state"
             value="/$(arg uav_ns)/ego_mavros_bridge/state"/>
      <param name="topics/mavros_state"
             value="/$(arg uav_ns)/mavros/state"/>
      <param name="topics/mavros_extended_state"
             value="/$(arg uav_ns)/mavros/extended_state"/>
      <param name="topics/goal"
             value="/$(arg uav_ns)/move_base_simple/goal"/>
      <param name="outputs/state"
             value="/$(arg uav_ns)/tower_mission/state"/>
      <param name="outputs/current_target"
             value="/$(arg uav_ns)/tower_mission/current_target"/>
      <param name="outputs/current_sector"
             value="/$(arg uav_ns)/tower_mission/current_sector"/>
      <param name="outputs/candidate_targets"
             value="/$(arg uav_ns)/tower_mission/candidate_targets"/>
      <param name="outputs/progress"
             value="/$(arg uav_ns)/tower_mission/progress"/>
      <param name="outputs/face_tower"
             value="/$(arg uav_ns)/tower_mission/face_tower"/>
      <param name="outputs/selected_tower_center"
             value="/$(arg uav_ns)/tower_mission/selected_tower_center"/>
      <param name="outputs/level_ingress_path"
             value="/$(arg uav_ns)/tower_mission/level_ingress_path"/>
      <param name="outputs/level_orbit_path"
             value="/$(arg uav_ns)/tower_mission/level_orbit_path"/>
      <param name="outputs/mission_route"
             value="/$(arg uav_ns)/tower_mission/mission_route"/>
      <param name="outputs/altitude_policy"
             value="/$(arg uav_ns)/tower_mission/altitude_policy"/>
      <param name="outputs/mission_success"
             value="/$(arg uav_ns)/tower_mission/mission_success"/>
      <param name="outputs/mission_failure"
             value="/$(arg uav_ns)/tower_mission/mission_failure"/>
      <param name="outputs/mission_done"
             value="/$(arg uav_ns)/tower_mission/mission_done"/>
      <param name="outputs/orbit_complete"
             value="/$(arg uav_ns)/tower_mission/orbit_complete"/>
      <param name="services/tracking"
             value="/$(arg uav_ns)/ego_mavros_bridge/enable_tracking"/>
      <param name="services/cancel"
             value="/$(arg uav_ns)/ego_mavros_bridge/cancel_current_trajectory"/>
      <param name="services/resume"
             value="/$(arg uav_ns)/ego_mavros_bridge/resume_ego"/>
      <param name="services/return_home"
             value="/$(arg uav_ns)/ego_mavros_bridge/return_home"/>
      <param name="services/land"
             value="/$(arg uav_ns)/ego_mavros_bridge/land"/>
      <param name="coordination/require_transition_permission"
             value="$(arg coordination_enabled)"/>
      <param name="coordination/require_task_start_permission"
             value="$(arg coordination_enabled)"/>
      <param name="coordination/require_entry_permission"
             value="$(arg coordination_enabled)"/>
      <param name="coordination/require_orbit_permission"
             value="$(arg orbit_permission_enabled)"/>
      <param name="coordination/require_orbit_staging_permission"
             value="$(arg orbit_permission_enabled)"/>
      <param name="coordination/require_exit_permission"
             value="$(arg coordination_enabled)"/>
      <param name="coordination/require_landing_permission"
             value="$(arg coordination_enabled)"/>
      <param name="coordination/permission_timeout" value="1.0"/>
      <param name="coordination/task_start_permission_topic"
             value="/$(arg uav_ns)/swarm/task_start_permission"/>
      <param name="coordination/transition_permission_topic"
             value="/$(arg uav_ns)/swarm/transition_permission"/>
      <param name="coordination/entry_permission_topic"
             value="/$(arg uav_ns)/swarm/entry_permission"/>
      <param name="coordination/entry_corridor_selection_topic"
             value="/$(arg uav_ns)/swarm/entry_corridor_selection"/>
      <param name="outputs/entry_corridor_candidates"
             value="/$(arg uav_ns)/tower_mission/entry_corridor_candidates"/>
      <param name="coordination/orbit_permission_topic"
             value="/$(arg uav_ns)/swarm/orbit_permission"/>
      <param name="coordination/orbit_staging_permission_topic"
             value="/$(arg uav_ns)/swarm/orbit_staging_permission"/>
      <param name="coordination/exit_permission_topic"
             value="/$(arg uav_ns)/swarm/exit_permission"/>
      <param name="coordination/landing_permission_topic"
             value="/$(arg uav_ns)/swarm/landing_permission"/>
    </node>
  </group>
</launch>

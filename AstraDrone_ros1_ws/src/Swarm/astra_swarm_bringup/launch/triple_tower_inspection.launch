<launch>
  <arg name="enable_control" default="false"/>
  <arg name="uav1_enable_control" default="$(arg enable_control)"/>
  <arg name="uav2_enable_control" default="$(arg enable_control)"/>
  <arg name="uav3_enable_control" default="$(arg enable_control)"/>
  <arg name="uav1_mission_enabled" default="true"/>
  <arg name="uav2_mission_enabled" default="true"/>
  <arg name="uav3_mission_enabled" default="true"/>
  <arg name="uav1_enabled" default="true"/>
  <arg name="uav2_enabled" default="true"/>
  <arg name="uav3_enabled" default="true"/>
  <arg name="uav1_coordination_enabled" default="true"/>
  <arg name="uav2_coordination_enabled" default="true"/>
  <arg name="uav3_coordination_enabled" default="true"/>
  <arg name="swarm_services_enabled" default="true"/>
  <arg name="swarm_vehicle_namespaces" default="[/uav1, /uav2, /uav3]"/>
  <arg name="start_sim" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_rviz_diagnostics" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="world"
       default="$(find env_map)/../../../astra_gazebo_worlds/worksite.world"/>
  <!-- D435 is not part of the current Mid360/FAST-LIO/EGO planning chain.
       Default true preserves the existing simulation; false is an explicit
       host-rendering workaround, not a mission or planner mode. -->
  <arg name="d435_enabled" default="true"/>
  <!-- Mid360 plugin-level ray decimation.  Keep 1 as the validated default;
       larger integers are explicit simulation resource trade-offs. -->
  <arg name="lidar_downsample" default="1"/>
  <arg name="task_config"
       default="$(find astra_tower_mission)/config/low_altitude_inspection.yaml"/>
  <arg name="takeoff_interval_sec" default="0.0"/>
  <arg name="target_phase_deg" default="67.5"/>
  <arg name="normal_phase_min_deg" default="57.5"/>
  <arg name="normal_phase_max_deg" default="77.5"/>
  <arg name="warning_phase_min_deg" default="45.0"/>
  <arg name="emergency_phase_deg" default="45.0"/>
  <arg name="leader_wait_phase_deg" default="95.0"/>
  <arg name="entry_nominal_speed" default="0.20"/>
  <arg name="orbit_nominal_speed" default="0.14"/>
  <arg name="low_altitude_enabled" default="true"/>
  <arg name="uav1_orbit_permission_enabled"
       default="$(arg low_altitude_enabled)"/>
  <arg name="uav2_orbit_permission_enabled"
       default="$(arg low_altitude_enabled)"/>
  <arg name="uav3_orbit_permission_enabled"
       default="$(arg low_altitude_enabled)"/>
  <arg name="uav1_orbit_speed_scale_enabled"
       default="$(arg low_altitude_enabled)"/>
  <arg name="uav2_orbit_speed_scale_enabled"
       default="$(arg low_altitude_enabled)"/>
  <arg name="uav3_orbit_speed_scale_enabled"
       default="$(arg low_altitude_enabled)"/>
  <!-- Declare the reviewed ceiling before Learning Speed uses it as a
       default; roslaunch resolves arg defaults in declaration order. -->
  <arg name="max_vel" default="0.20"/>
  <arg name="learning_speed_enabled" default="false"/>
  <arg name="uav1_learning_speed_enabled"
       default="$(arg learning_speed_enabled)"/>
  <arg name="uav2_learning_speed_enabled"
       default="$(arg learning_speed_enabled)"/>
  <arg name="uav3_learning_speed_enabled"
       default="$(arg learning_speed_enabled)"/>
  <arg name="learning_speed_config"
       default="$(find learning_speed_rl)/config/speed_adapter.yaml"/>
  <arg name="learning_speed_policy_mode" default="mock"/>
  <arg name="learning_speed_fixed_v_max" default="$(arg max_vel)"/>
  <arg name="uav1_bridge_config"
       default="$(find astra_swarm_bringup)/config/uav1_bridge.yaml"/>
  <arg name="uav1_entry_sector" default="7"/>
  <arg name="uav2_entry_sector" default="8"/>
  <arg name="uav3_entry_sector" default="1"/>
  <arg name="uav1_entry_angle_deg" default="292.5"/>
  <arg name="uav2_entry_angle_deg" default="315.0"/>
  <arg name="uav3_entry_angle_deg" default="337.5"/>
  <arg name="pre_entry_radius" default="18.0"/>
  <arg name="entry_target_timeout" default="360.0"/>
  <arg name="inspection_laps" default="1"/>
  <arg name="mission_overall_timeout" default="3600.0"/>
  <arg name="uav1_top_height" default="3.0"/>
  <arg name="uav2_top_height" default="3.0"/>
  <arg name="uav3_top_height" default="3.0"/>
  <arg name="uav1_takeoff_height" default="3.0"/>
  <arg name="uav2_takeoff_height" default="3.0"/>
  <arg name="uav3_takeoff_height" default="3.0"/>
  <arg name="uav1_spawn_x" default="0.0"/>
  <arg name="uav2_spawn_x" default="4.0"/>
  <arg name="uav3_spawn_x" default="8.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="tower_center_x" default="-10.0551"/>
  <arg name="tower_center_y" default="19.7104"/>
  <arg name="crane_center_x" default="2.7535"/>
  <arg name="map_size_z" default="46.0"/>
  <!-- UAV3's local tower center is x=-18.0551.  A 16.5 m same-sector
       candidate plus the unchanged 7.5 m EGO horizon reaches x=-42.0551;
       the former 60 m map ended at x=-30 and produced a false occupancy
       diagnosis when GridMap returned -1 for out-of-map positions. -->
  <arg name="map_size_x" default="90.0"/>
  <arg name="map_size_y" default="90.0"/>
  <arg name="map_resolution" default="0.25"/>
  <arg name="ground_height" default="-0.50"/>
  <arg name="virtual_ceil_height" default="45.0"/>
  <arg name="mission_maximum_height" default="45.0"/>
  <arg name="uav1_mission_minimum_height" default="1.0"/>
  <arg name="uav2_mission_minimum_height" default="2.0"/>
  <arg name="uav3_mission_minimum_height" default="2.0"/>
  <arg name="max_acc" default="0.50"/>
  <arg name="planning_horizon" default="7.5"/>
  <arg name="obstacles_inflation" default="0.40"/>
  <arg name="swarm_clearance" default="1.50"/>
  <arg name="prefer_clear_straight_corridor" default="true"/>
  <arg name="uav1_report_file"
       default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/uav1.csv"/>
  <arg name="uav2_report_file"
       default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/uav2.csv"/>
  <arg name="uav3_report_file"
       default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/uav3.csv"/>
  <arg name="evidence_csv_file"
       default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/swarm.csv"/>
  <arg name="evidence_summary_file"
       default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/summary.json"/>
  <arg name="evidence_candidate_file"
       default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/candidates.jsonl"/>
  <arg name="evidence_record_enabled" default="true"/>
  <arg name="evidence_candidate_record_mode" default="full"/>
  <env name="ROS_LOG_DIR"
       value="$(optenv ROS_LOG_DIR runtime_artifacts/direct_triple_tower/ros_logs)"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include if="$(arg start_sim)"
           file="$(find astra_swarm_bringup)/launch/triple_px4_mavros.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="uav1_spawn_x" value="$(arg uav1_spawn_x)"/>
    <arg name="uav2_spawn_x" value="$(arg uav2_spawn_x)"/>
    <arg name="uav3_spawn_x" value="$(arg uav3_spawn_x)"/>
    <arg name="uav1_enabled" value="$(arg uav1_enabled)"/>
    <arg name="uav2_enabled" value="$(arg uav2_enabled)"/>
    <arg name="uav3_enabled" value="$(arg uav3_enabled)"/>
    <arg name="d435_enabled" value="$(arg d435_enabled)"/>
    <arg name="lidar_downsample" value="$(arg lidar_downsample)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
  </include>

  <!-- Reuse the audited uav1/uav2 sensor, mission and safety wiring.  The
       include does not start a second Gazebo/PX4 instance. -->
  <include file="$(find astra_swarm_bringup)/launch/dual_tower_inspection.launch">
    <arg name="enable_control" value="false"/>
    <arg name="uav1_enable_control" value="$(arg uav1_enable_control)"/>
    <arg name="uav2_enable_control" value="$(arg uav2_enable_control)"/>
    <arg name="uav1_mission_enabled" value="$(arg uav1_mission_enabled)"/>
    <arg name="uav2_mission_enabled" value="$(arg uav2_mission_enabled)"/>
    <arg name="uav1_enabled" value="$(arg uav1_enabled)"/>
    <arg name="uav2_enabled" value="$(arg uav2_enabled)"/>
    <arg name="uav1_coordination_enabled"
         value="$(arg uav1_coordination_enabled)"/>
    <arg name="uav2_coordination_enabled"
         value="$(arg uav2_coordination_enabled)"/>
    <arg name="swarm_services_enabled" value="$(arg swarm_services_enabled)"/>
    <arg name="swarm_manager_config"
         value="$(find astra_swarm_manager)/config/three_uav_inspection_formation.yaml"/>
    <arg name="start_sim" value="false"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="task_config" value="$(arg task_config)"/>
    <arg name="low_altitude_enabled" value="$(arg low_altitude_enabled)"/>
    <arg name="uav1_orbit_permission_enabled"
         value="$(arg uav1_orbit_permission_enabled)"/>
    <arg name="uav2_orbit_permission_enabled"
         value="$(arg uav2_orbit_permission_enabled)"/>
    <arg name="uav1_orbit_speed_scale_enabled"
         value="$(arg uav1_orbit_speed_scale_enabled)"/>
    <arg name="uav2_orbit_speed_scale_enabled"
         value="$(arg uav2_orbit_speed_scale_enabled)"/>
    <arg name="uav1_learning_speed_enabled"
         value="$(arg uav1_learning_speed_enabled)"/>
    <arg name="uav2_learning_speed_enabled"
         value="$(arg uav2_learning_speed_enabled)"/>
    <arg name="learning_speed_config" value="$(arg learning_speed_config)"/>
    <arg name="learning_speed_policy_mode"
         value="$(arg learning_speed_policy_mode)"/>
    <arg name="learning_speed_fixed_v_max"
         value="$(arg learning_speed_fixed_v_max)"/>
    <arg name="uav1_bridge_config" value="$(arg uav1_bridge_config)"/>
    <arg name="takeoff_delay" value="$(arg takeoff_interval_sec)"/>
    <arg name="uav1_spawn_x" value="$(arg uav1_spawn_x)"/>
    <arg name="uav2_spawn_x" value="$(arg uav2_spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="uav1_top_height" value="$(arg uav1_top_height)"/>
    <arg name="uav2_top_height" value="$(arg uav2_top_height)"/>
    <arg name="uav1_takeoff_height" value="$(arg uav1_takeoff_height)"/>
    <arg name="uav2_takeoff_height" value="$(arg uav2_takeoff_height)"/>
    <arg name="uav1_staging_height"
         value="$(eval float(arg('uav1_top_height')) - 0.5)"/>
    <arg name="uav2_staging_height"
         value="$(eval float(arg('uav2_top_height')) - 0.5)"/>
    <arg name="uav1_layer_offsets" value="[0.0]"/>
    <arg name="uav2_layer_offsets" value="[0.0]"/>
    <arg name="uav1_candidate_height_offsets" value="[0.0]"/>
    <arg name="uav2_candidate_height_offsets" value="[0.0]"/>
    <arg name="uav1_entry_sector" value="$(arg uav1_entry_sector)"/>
    <arg name="uav2_entry_sector" value="$(arg uav2_entry_sector)"/>
    <arg name="uav1_entry_angle_deg" value="$(arg uav1_entry_angle_deg)"/>
    <arg name="uav2_entry_angle_deg" value="$(arg uav2_entry_angle_deg)"/>
    <arg name="pre_entry_radius" value="$(arg pre_entry_radius)"/>
    <arg name="entry_target_timeout" value="$(arg entry_target_timeout)"/>
    <arg name="inspection_laps" value="$(arg inspection_laps)"/>
    <arg name="mission_overall_timeout"
         value="$(arg mission_overall_timeout)"/>
    <!-- Keep the EGO map valid across the task's already-authorized vertical
         recovery envelope.  A floor tied to top_height - 0.4 made normal
         tracking error look like occupancy because GridMap returns -1 below
         its map origin.  Mission targets remain fixed at top_height. -->
    <arg name="uav1_low_floor"
         value="$(arg uav1_mission_minimum_height)"/>
    <arg name="uav2_low_floor"
         value="$(arg uav2_mission_minimum_height)"/>
    <arg name="uav1_low_ceiling"
         value="$(eval float(arg('uav1_top_height')) + 1.5)"/>
    <arg name="uav2_low_ceiling"
         value="$(eval float(arg('uav2_top_height')) + 1.5)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="ground_height" value="$(arg ground_height)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <arg name="mission_maximum_height" value="$(arg mission_maximum_height)"/>
    <arg name="uav1_mission_minimum_height"
         value="$(arg uav1_mission_minimum_height)"/>
    <arg name="uav2_mission_minimum_height"
         value="$(arg uav2_mission_minimum_height)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="prefer_clear_straight_corridor"
         value="$(arg prefer_clear_straight_corridor)"/>
    <arg name="uav1_report_file" value="$(arg uav1_report_file)"/>
    <arg name="uav2_report_file" value="$(arg uav2_report_file)"/>
    <arg name="swarm_uav_ids" value="[1, 2, 3]"/>
    <arg name="swarm_vehicle_namespaces" value="$(arg swarm_vehicle_namespaces)"/>
    <arg name="swarm_mission_heights"
         value="[$(arg uav1_top_height), $(arg uav2_top_height), $(arg uav3_top_height)]"/>
    <arg name="swarm_phase_degrees"
         value="[$(arg uav1_entry_angle_deg), $(arg uav2_entry_angle_deg), $(arg uav3_entry_angle_deg)]"/>
    <arg name="tower_center_x" value="$(arg tower_center_x)"/>
    <arg name="tower_center_y" value="$(arg tower_center_y)"/>
    <arg name="crane_center_x" value="$(arg crane_center_x)"/>
    <arg name="swarm_tower_center"
         value="[$(arg tower_center_x), $(arg tower_center_y)]"/>
    <arg name="desired_phase_separation_degrees"
         value="$(arg target_phase_deg)"/>
    <arg name="formation_role_order" value="[3, 2, 1]"/>
    <arg name="target_phase_deg" value="$(arg target_phase_deg)"/>
    <arg name="normal_phase_min_deg" value="$(arg normal_phase_min_deg)"/>
    <arg name="normal_phase_max_deg" value="$(arg normal_phase_max_deg)"/>
    <arg name="warning_phase_min_deg" value="$(arg warning_phase_min_deg)"/>
    <arg name="emergency_phase_deg" value="$(arg emergency_phase_deg)"/>
    <arg name="leader_wait_phase_deg" value="$(arg leader_wait_phase_deg)"/>
    <arg name="entry_nominal_speed" value="$(arg entry_nominal_speed)"/>
    <arg name="orbit_nominal_speed" value="$(arg orbit_nominal_speed)"/>
    <arg name="swarm_home_positions"
         value="[[$(arg uav1_spawn_x), $(arg spawn_y), 0.0], [$(arg uav2_spawn_x), $(arg spawn_y), 0.0], [$(arg uav3_spawn_x), $(arg spawn_y), 0.0]]"/>
    <arg name="swarm_takeoff_heights"
         value="[$(arg uav1_takeoff_height), $(arg uav2_takeoff_height), $(arg uav3_takeoff_height)]"/>
    <arg name="uav1_peer_state_topics"
         value="[/uav2/swarm/state, /uav3/swarm/state]"/>
    <arg name="uav2_peer_state_topics"
         value="[/uav1/swarm/state, /uav3/swarm/state]"/>
  </include>

  <node if="$(arg uav3_enabled)"
        pkg="tf2_ros" type="static_transform_publisher"
        name="world_to_uav3_map"
        args="$(arg uav3_spawn_x) $(arg spawn_y) 0 0 0 0 1 world uav3/map"/>

  <group if="$(arg uav3_enabled)" ns="uav3">
    <group>
      <remap from="/livox/lidar" to="/uav3/livox/lidar"/>
      <remap from="/livox/imu" to="/uav3/livox/imu"/>
      <remap from="/Odometry" to="/uav3/fast_lio/Odometry_raw"/>
      <remap from="/cloud_registered"
             to="/uav3/fast_lio/cloud_registered_raw"/>
      <remap from="/cloud_registered_body"
             to="/uav3/fast_lio/cloud_registered_body_raw"/>
      <remap from="/path" to="/uav3/fast_lio/path_raw"/>
      <remap from="/Laser_map" to="/uav3/fast_lio/Laser_map_raw"/>
      <remap from="/tf" to="/uav3/fast_lio/tf_raw"/>
      <include file="$(find fast_lio)/launch/mapping_mid360.launch">
        <arg name="rviz" value="false"/>
      </include>
    </group>
    <include file="$(find astra_swarm_bringup)/launch/uav_sensor_frames.launch">
      <arg name="frame_prefix" value="uav3"/>
      <arg name="model_name" value="uav3"/>
    </include>
    <node pkg="astra_swarm_tf" type="frame_adapter_node.py"
          name="frame_adapter" output="screen" required="true">
      <param name="frame_prefix" value="uav3"/>
      <param name="odom_input" value="/uav3/fast_lio/Odometry_raw"/>
      <param name="odom_output" value="/uav3/Odometry"/>
      <param name="cloud_input" value="/uav3/fast_lio/cloud_registered_raw"/>
      <param name="cloud_output" value="/uav3/cloud_registered"/>
      <param name="tf_input" value="/uav3/fast_lio/tf_raw"/>
      <param name="tf_output" value="/tf"/>
      <param name="mavros_pose_input"
             value="/uav3/mavros/local_position/pose"/>
      <param name="mavros_pose_output"
             value="/uav3/mavros/local_position/pose_framed"/>
      <param name="mavros_odom_output"
             value="/uav3/mavros/odometry/out"/>
    </node>
    <node pkg="astra_swarm_perception" type="teammate_cloud_filter_node"
          name="teammate_cloud_filter" output="screen" required="true">
      <rosparam command="load"
                file="$(find astra_swarm_perception)/config/dual_tower.yaml"/>
      <param name="input_topic" value="/uav3/cloud_registered"/>
      <param name="output_topic"
             value="/uav3/cloud_registered_peer_filtered"/>
      <rosparam param="peer_state_topics">
        [/uav1/swarm/state, /uav2/swarm/state]
      </rosparam>
      <param name="home_x" value="$(arg uav3_spawn_x)"/>
      <param name="home_y" value="$(arg spawn_y)"/>
      <param name="home_z" value="0.0"/>
    </node>
    <node pkg="astra_swarm_perception" type="self_cloud_filter_node"
          name="self_cloud_filter" output="screen" required="true">
      <rosparam command="load"
                file="$(find astra_swarm_perception)/config/iris_mid360_self_exclusion.yaml"/>
      <param name="input_topic"
             value="/uav3/cloud_registered_peer_filtered"/>
      <param name="odom_topic" value="/uav3/Odometry"/>
      <param name="output_topic"
             value="/uav3/cloud_registered_self_filtered"/>
      <param name="before_topic" value="/uav3/stage5/cloud_before_self"/>
      <param name="after_topic" value="/uav3/stage5/cloud_after_self"/>
      <param name="inflated_occupancy_topic"
             value="/uav3/stage3/occupancy_inflate"/>
      <param name="diagnostic_topic"
             value="/uav3/stage5/cloud_filter_diagnostics"/>
    </node>
    <group ns="swarm">
      <node pkg="astra_swarm_manager" type="swarm_state_publisher.py"
            name="state_publisher" output="screen" required="true">
        <param name="uav_id" value="3"/>
        <param name="vehicle_namespace" value="/uav3"/>
        <rosparam param="home_position"
                  subst_value="true">[$(arg uav3_spawn_x), $(arg spawn_y), 0.0]</rosparam>
        <param name="odom_topic" value="/uav3/Odometry"/>
        <param name="target_topic"
               value="/uav3/tower_mission/current_target"/>
        <param name="mission_state_topic"
               value="/uav3/tower_mission/state"/>
        <param name="bridge_state_topic"
               value="/uav3/ego_mavros_bridge/state"/>
        <param name="mavros_state_topic" value="/uav3/mavros/state"/>
        <param name="trajectory_prediction_horizon" value="4.0"/>
        <param name="trajectory_prediction_period" value="0.25"/>
        <param name="velocity_filter_alpha" value="0.25"/>
        <param name="acceleration_filter_alpha" value="0.15"/>
        <param name="maximum_prediction_speed" value="$(arg max_vel)"/>
        <param name="maximum_prediction_acceleration" value="$(arg max_acc)"/>
        <param name="heartbeat_timeout" value="1.0"/>
      </node>
    </group>
  </group>

  <include if="$(arg uav3_enabled)"
           file="$(find astra_swarm_bringup)/launch/uav_tower_stack.launch">
    <arg name="mission_enabled" value="$(arg uav3_mission_enabled)"/>
    <arg name="require_start_permission"
         value="$(arg uav3_coordination_enabled)"/>
    <arg name="uav_ns" value="uav3"/>
    <arg name="uav_id" value="3"/>
    <arg name="planner_drone_id" value="2"/>
    <arg name="enable_control" value="$(arg uav3_enable_control)"/>
    <arg name="takeoff_delay" value="0.0"/>
    <arg name="planning_frame" value="uav3/camera_init"/>
    <arg name="mavros_frame" value="uav3/map"/>
    <arg name="inspection_top_height" value="$(arg uav3_top_height)"/>
    <arg name="layer_offsets" value="[0.0]"/>
    <arg name="takeoff_height" value="$(arg uav3_takeoff_height)"/>
    <arg name="staging_height"
         value="$(eval float(arg('uav3_top_height')) - 0.5)"/>
    <arg name="low_altitude_enabled" value="$(arg low_altitude_enabled)"/>
    <arg name="orbit_permission_enabled"
         value="$(arg uav3_orbit_permission_enabled)"/>
    <arg name="orbit_speed_scale_enabled"
         value="$(arg uav3_orbit_speed_scale_enabled)"/>
    <arg name="learning_speed_enabled"
         value="$(arg uav3_learning_speed_enabled)"/>
    <arg name="learning_speed_config" value="$(arg learning_speed_config)"/>
    <arg name="learning_speed_policy_mode"
         value="$(arg learning_speed_policy_mode)"/>
    <arg name="learning_speed_fixed_v_max"
         value="$(arg learning_speed_fixed_v_max)"/>
    <arg name="entry_sector" value="$(arg uav3_entry_sector)"/>
    <arg name="entry_angle_deg" value="$(arg uav3_entry_angle_deg)"/>
    <arg name="pre_entry_radius" value="$(arg pre_entry_radius)"/>
    <arg name="entry_target_timeout" value="$(arg entry_target_timeout)"/>
    <arg name="inspection_laps" value="$(arg inspection_laps)"/>
    <arg name="mission_overall_timeout"
         value="$(arg mission_overall_timeout)"/>
    <arg name="low_altitude_floor_height"
         value="$(arg uav3_mission_minimum_height)"/>
    <arg name="low_altitude_ceiling_height"
         value="$(eval float(arg('uav3_top_height')) + 1.5)"/>
    <arg name="coordination_enabled" value="$(arg uav3_coordination_enabled)"/>
    <arg name="task_config" value="$(arg task_config)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="ground_height" value="$(arg ground_height)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <arg name="mission_maximum_height" value="$(arg mission_maximum_height)"/>
    <arg name="mission_minimum_height"
         value="$(arg uav3_mission_minimum_height)"/>
    <arg name="candidate_height_offsets" value="[0.0]"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="prefer_clear_straight_corridor"
         value="$(arg prefer_clear_straight_corridor)"/>
    <arg name="swarm_origin_x" value="$(arg uav3_spawn_x)"/>
    <arg name="swarm_origin_y" value="$(arg spawn_y)"/>
    <arg name="tower_center_x"
         value="$(eval -10.0551 - float(arg('uav3_spawn_x')))"/>
    <arg name="tower_center_y"
         value="$(eval 19.7104 - float(arg('spawn_y')))"/>
    <arg name="crane_center_x"
         value="$(eval 2.7535 - float(arg('uav3_spawn_x')))"/>
    <arg name="bridge_config"
         value="$(find astra_swarm_bringup)/config/uav3_bridge.yaml"/>
    <arg name="report_file" value="$(arg uav3_report_file)"/>
    <arg name="trajectory_color_r" value="0.4"/>
    <arg name="trajectory_color_g" value="1.0"/>
    <arg name="trajectory_color_b" value="0.2"/>
  </include>

  <node if="$(arg evidence_record_enabled)"
        pkg="astra_swarm_bringup" type="swarm_evidence_recorder.py"
        name="astra_swarm_evidence_recorder" output="screen">
    <rosparam param="uav_ids">[1, 2, 3]</rosparam>
    <rosparam param="tower_center">[-10.0551, 19.7104]</rosparam>
    <rosparam param="formation_role_order">[3, 2, 1]</rosparam>
    <param name="target_phase_deg" value="$(arg target_phase_deg)"/>
    <param name="csv_file" value="$(arg evidence_csv_file)"/>
    <param name="summary_file" value="$(arg evidence_summary_file)"/>
    <param name="candidate_file" value="$(arg evidence_candidate_file)"/>
    <param name="candidate_record_mode"
           value="$(arg evidence_candidate_record_mode)"/>
  </node>

  <node if="$(arg start_rviz_diagnostics)"
        pkg="astra_swarm_bringup" type="swarm_rviz_diagnostics.py"
        name="astra_swarm_rviz_diagnostics" output="screen" required="true">
    <rosparam param="uav_ids">[1, 2, 3]</rosparam>
    <rosparam param="tower_center">[-10.0551, 19.7104]</rosparam>
    <param name="orbit_radius" value="12.5"/>
    <param name="entry_gate_radius" value="15.0"/>
    <rosparam param="mission_heights"
              subst_value="true">[$(arg uav1_top_height), $(arg uav2_top_height), $(arg uav3_top_height)]</rosparam>
    <rosparam param="entry_angles_deg"
              subst_value="true">[$(arg uav1_entry_angle_deg), $(arg uav2_entry_angle_deg), $(arg uav3_entry_angle_deg)]</rosparam>
    <param name="pre_entry_radius" value="$(arg pre_entry_radius)"/>
    <rosparam param="formation_role_order">[3, 2, 1]</rosparam>
    <rosparam param="home_positions" subst_value="true">
      [[$(arg uav1_spawn_x), $(arg spawn_y)], [$(arg uav2_spawn_x), $(arg spawn_y)], [$(arg uav3_spawn_x), $(arg spawn_y)]]
    </rosparam>
  </node>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="astra_swarm_three_uav_rviz" output="screen"
        args="-f world -d $(find astra_swarm_bringup)/config/triple_tower.rviz"/>
</launch>

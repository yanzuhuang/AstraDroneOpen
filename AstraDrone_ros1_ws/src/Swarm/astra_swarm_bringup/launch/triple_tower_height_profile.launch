<launch>
  <!-- Named, complete height contracts. Unknown names fail during expansion. -->
  <arg name="height_profile" default="same_3m"/>
  <arg name="enable_control" default="false" />
  <arg name="start_sim" default="true" />
  <arg name="gui" default="true" />
  <arg name="start_rviz" default="true" />
  <arg name="start_rviz_diagnostics" default="true" />
  <arg name="use_sim_time" default="true" />
  <arg name="world" default="$(find env_map)/../../../astra_gazebo_worlds/worksite.world" />
  <arg name="d435_enabled" default="true" />
  <arg name="lidar_downsample" default="1" />
  <arg name="learning_speed_enabled" default="false" />
  <arg name="uav1_report_file" default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/uav1.csv" />
  <arg name="uav2_report_file" default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/uav2.csv" />
  <arg name="uav3_report_file" default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/uav3.csv" />
  <arg name="evidence_csv_file" default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/swarm.csv" />
  <arg name="evidence_summary_file" default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/summary.json" />
  <arg name="evidence_candidate_file" default="$(find astra_swarm_bringup)/../../../../runtime_artifacts/direct_triple_tower/candidates.jsonl" />
  <arg name="evidence_record_enabled" default="true" />
  <arg name="evidence_candidate_record_mode" default="full" />
  <arg name="top1" value="$(eval {'same_3m': 3.0, 'same_30m': 30.0, 'multi_height_low_3m': 15.0}[arg('height_profile')])"/>
  <arg name="top2" value="$(eval {'same_3m': 3.0, 'same_30m': 30.0, 'multi_height_low_3m': 9.0}[arg('height_profile')])"/>
  <arg name="top3" value="$(eval {'same_3m': 3.0, 'same_30m': 30.0, 'multi_height_low_3m': 3.0}[arg('height_profile')])"/>
  <include file="$(eval find('astra_swarm_bringup') + '/launch/' + ('triple_tower_multi_height_inspection.launch' if arg('height_profile') == 'multi_height_low_3m' else 'triple_tower_inspection.launch'))">
    <arg name="enable_control" value="$(arg enable_control)"/>
    <arg name="start_sim" value="$(arg start_sim)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="start_rviz_diagnostics" value="$(arg start_rviz_diagnostics)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="d435_enabled" value="$(arg d435_enabled)"/>
    <arg name="lidar_downsample" value="$(arg lidar_downsample)"/>
    <arg name="learning_speed_enabled" value="$(arg learning_speed_enabled)"/>
    <arg name="uav1_report_file" value="$(arg uav1_report_file)"/>
    <arg name="uav2_report_file" value="$(arg uav2_report_file)"/>
    <arg name="uav3_report_file" value="$(arg uav3_report_file)"/>
    <arg name="evidence_csv_file" value="$(arg evidence_csv_file)"/>
    <arg name="evidence_summary_file" value="$(arg evidence_summary_file)"/>
    <arg name="evidence_candidate_file" value="$(arg evidence_candidate_file)"/>
    <arg name="evidence_record_enabled" value="$(arg evidence_record_enabled)"/>
    <arg name="evidence_candidate_record_mode" value="$(arg evidence_candidate_record_mode)"/>
    <arg name="multi_layer_enabled" value="false"/>
    <arg name="uav1_top_height" value="$(arg top1)"/>
    <arg name="uav1_takeoff_height" value="$(eval min(4.0, float(arg('top1')) - 0.5) if arg('height_profile') == 'multi_height_low_3m' else arg('top1'))"/>
    <arg name="uav1_staging_height" value="$(eval min(4.0, float(arg('top1')) - 0.5) if arg('height_profile') == 'multi_height_low_3m' else float(arg('top1')) - 0.5)"/>
    <arg name="uav2_top_height" value="$(arg top2)"/>
    <arg name="uav2_takeoff_height" value="$(eval min(4.0, float(arg('top2')) - 0.5) if arg('height_profile') == 'multi_height_low_3m' else arg('top2'))"/>
    <arg name="uav2_staging_height" value="$(eval min(4.0, float(arg('top2')) - 0.5) if arg('height_profile') == 'multi_height_low_3m' else float(arg('top2')) - 0.5)"/>
    <arg name="uav3_top_height" value="$(arg top3)"/>
    <arg name="uav3_takeoff_height" value="$(eval min(4.0, float(arg('top3')) - 0.5) if arg('height_profile') == 'multi_height_low_3m' else arg('top3'))"/>
    <arg name="uav3_staging_height" value="$(eval min(4.0, float(arg('top3')) - 0.5) if arg('height_profile') == 'multi_height_low_3m' else float(arg('top3')) - 0.5)"/>
  </include>
  <!-- Height-only overrides after included YAML/launch defaults. All envelopes
       cover the same targets; recovery and fallback return stay at the layer. -->
  <param name="/uav1/ego_mavros_bridge/min_relative_height" value="0.3"/>
  <param name="/uav1/ego_mavros_bridge/max_relative_height" value="$(eval float(arg('top1')) + 1.5)"/>
  <param name="/uav1/ego_mavros_bridge/takeoff_timeout" value="$(eval 120.0 if arg('height_profile') == 'same_30m' else 60.0)"/>
  <param name="/uav1/tower_mission/mission/recovery_height_max" value="$(arg top1)"/>
  <param name="/uav1/tower_mission/recovery/recovery_height" value="$(arg top1)"/>
  <param name="/uav1/tower_mission/return_egress/transit_height" value="$(arg top1)"/>
  <param name="/uav2/ego_mavros_bridge/min_relative_height" value="0.3"/>
  <param name="/uav2/ego_mavros_bridge/max_relative_height" value="$(eval float(arg('top2')) + 1.5)"/>
  <param name="/uav2/ego_mavros_bridge/takeoff_timeout" value="$(eval 120.0 if arg('height_profile') == 'same_30m' else 60.0)"/>
  <param name="/uav2/tower_mission/mission/recovery_height_max" value="$(arg top2)"/>
  <param name="/uav2/tower_mission/recovery/recovery_height" value="$(arg top2)"/>
  <param name="/uav2/tower_mission/return_egress/transit_height" value="$(arg top2)"/>
  <param name="/uav3/ego_mavros_bridge/min_relative_height" value="0.3"/>
  <param name="/uav3/ego_mavros_bridge/max_relative_height" value="$(eval float(arg('top3')) + 1.5)"/>
  <param name="/uav3/ego_mavros_bridge/takeoff_timeout" value="$(eval 120.0 if arg('height_profile') == 'same_30m' else 60.0)"/>
  <param name="/uav3/tower_mission/mission/recovery_height_max" value="$(arg top3)"/>
  <param name="/uav3/tower_mission/recovery/recovery_height" value="$(arg top3)"/>
  <param name="/uav3/tower_mission/return_egress/transit_height" value="$(arg top3)"/>
  <param name="/uav1/tower_mission/mission/maximum_height" value="$(eval float(arg('top1')) + 1.5)"/>
  <param name="/uav1/tower_mission/mission/virtual_ceil_height" value="$(eval float(arg('top1')) + 1.5)"/>
  <param name="/uav1/drone_0_ego_planner_node/grid_map/virtual_ceil_height" value="$(eval float(arg('top1')) + 1.5)"/>
  <param name="/uav2/tower_mission/mission/maximum_height" value="$(eval float(arg('top2')) + 1.5)"/>
  <param name="/uav2/tower_mission/mission/virtual_ceil_height" value="$(eval float(arg('top2')) + 1.5)"/>
  <param name="/uav2/drone_1_ego_planner_node/grid_map/virtual_ceil_height" value="$(eval float(arg('top2')) + 1.5)"/>
  <param name="/uav3/tower_mission/mission/maximum_height" value="$(eval float(arg('top3')) + 1.5)"/>
  <param name="/uav3/tower_mission/mission/virtual_ceil_height" value="$(eval float(arg('top3')) + 1.5)"/>
  <param name="/uav3/drone_2_ego_planner_node/grid_map/virtual_ceil_height" value="$(eval float(arg('top3')) + 1.5)"/>
</launch>

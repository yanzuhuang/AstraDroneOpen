<launch>
  <arg name="enable_control" default="false"/>
  <arg name="uav1_enable_control" default="$(arg enable_control)"/>
  <arg name="uav2_enable_control" default="$(arg enable_control)"/>
  <arg name="uav1_mission_enabled" default="true"/>
  <arg name="uav2_mission_enabled" default="true"/>
  <arg name="uav1_enabled" default="true"/>
  <arg name="uav2_enabled" default="true"/>
  <arg name="uav1_coordination_enabled" default="true"/>
  <arg name="uav2_coordination_enabled" default="true"/>
  <!-- Disable only the fleet-wide coordinator/guard/safety processes for a
       deliberately isolated single-UAV reproduction.  Per-UAV bridge,
       planner, localization, timestamp and obstacle gates stay enabled. -->
  <arg name="swarm_services_enabled" default="true"/>
  <arg name="swarm_manager_config"
       default="$(find astra_swarm_manager)/config/dual_tower.yaml"/>
  <arg name="start_sim" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="enable_cloud_fusion" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="task_config"
       default="$(find astra_tower_mission)/config/stage3_ego.yaml"/>
  <arg name="low_altitude_enabled" default="false"/>
  <arg name="orbit_permission_enabled"
       default="$(arg low_altitude_enabled)"/>
  <arg name="uav1_orbit_permission_enabled"
       default="$(arg orbit_permission_enabled)"/>
  <arg name="uav2_orbit_permission_enabled"
       default="$(arg orbit_permission_enabled)"/>
  <arg name="uav1_orbit_speed_scale_enabled" default="false"/>
  <arg name="uav2_orbit_speed_scale_enabled" default="false"/>
  <arg name="takeoff_delay" default="6.0"/>
  <arg name="uav1_top_height" default="34.0"/>
  <arg name="uav2_top_height" default="28.0"/>
  <arg name="uav1_final_height" default="30.0"/>
  <arg name="uav2_final_height" default="24.0"/>
  <arg name="uav1_takeoff_height" default="4.0"/>
  <arg name="uav2_takeoff_height" default="4.0"/>
  <arg name="uav1_staging_height" default="$(arg uav1_takeoff_height)"/>
  <arg name="uav2_staging_height" default="$(arg uav2_takeoff_height)"/>
  <arg name="uav1_layer_offsets" default="[0.0, -4.0]"/>
  <arg name="uav2_layer_offsets" default="[0.0, -4.0]"/>
  <arg name="uav1_candidate_height_offsets" default="[0.0, -1.0, -2.0]"/>
  <arg name="uav2_candidate_height_offsets" default="[0.0, -1.0, -2.0]"/>
  <arg name="uav1_entry_sector" default="7"/>
  <arg name="uav2_entry_sector" default="2"/>
  <arg name="uav1_entry_angle_deg"
       default="$(eval (float(arg('uav1_entry_sector')) - 1.0) * 45.0)"/>
  <arg name="uav2_entry_angle_deg"
       default="$(eval (float(arg('uav2_entry_sector')) - 1.0) * 45.0)"/>
  <arg name="pre_entry_radius" default="18.0"/>
  <arg name="entry_target_timeout" default="120.0"/>
  <arg name="inspection_laps" default="1"/>
  <arg name="mission_overall_timeout" default="1200.0"/>
  <arg name="uav1_low_floor" default="1.6"/>
  <arg name="uav2_low_floor" default="2.6"/>
  <arg name="uav1_low_ceiling" default="3.0"/>
  <arg name="uav2_low_ceiling" default="4.0"/>
  <arg name="uav1_spawn_x" default="0.0"/>
  <arg name="uav2_spawn_x" default="2.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="swarm_uav_ids" default="[1, 2]"/>
  <arg name="swarm_vehicle_namespaces" default="[/uav1, /uav2]"/>
  <arg name="swarm_mission_heights" default="[34.0, 28.0]"/>
  <arg name="swarm_phase_degrees" default="[270.0, 45.0]"/>
  <arg name="swarm_tower_center" default="[-10.0551, 19.7104]"/>
  <arg name="desired_phase_separation_degrees" default="120.0"/>
  <arg name="phase_tolerance_degrees" default="15.0"/>
  <arg name="entry_nominal_speed" default="0.20"/>
  <arg name="orbit_nominal_speed" default="0.14"/>
  <arg name="formation_role_order" default="[2, 1]"/>
  <arg name="target_phase_deg" default="67.5"/>
  <arg name="normal_phase_min_deg" default="57.5"/>
  <arg name="normal_phase_max_deg" default="77.5"/>
  <arg name="warning_phase_min_deg" default="45.0"/>
  <arg name="emergency_phase_deg" default="45.0"/>
  <arg name="leader_wait_phase_deg" default="95.0"/>
  <arg name="entry_ready_timeout" default="360.0"/>
  <arg name="swarm_home_positions"
       default="[[0.0, 0.0, 0.0], [2.0, 0.0, 0.0]]"/>
  <arg name="swarm_takeoff_heights" default="[4.0, 4.0]"/>
  <arg name="uav1_peer_state_topics" default="[/uav2/swarm/state]"/>
  <arg name="uav2_peer_state_topics" default="[/uav1/swarm/state]"/>
  <arg name="map_size_z" default="46.0"/>
  <arg name="map_size_x" default="90.0"/>
  <arg name="map_size_y" default="120.0"/>
  <arg name="map_resolution" default="0.20"/>
  <arg name="ground_height" default="-0.50"/>
  <arg name="virtual_ceil_height" default="45.0"/>
  <arg name="mission_maximum_height" default="45.0"/>
  <arg name="uav1_mission_minimum_height" default="2.0"/>
  <arg name="uav2_mission_minimum_height" default="2.0"/>
  <arg name="max_vel" default="0.30"/>
  <arg name="max_acc" default="0.50"/>
  <arg name="planning_horizon" default="7.5"/>
  <arg name="obstacles_inflation" default="0.40"/>
  <arg name="swarm_clearance" default="1.50"/>
  <arg name="prefer_clear_straight_corridor" default="false"/>
  <arg name="uav1_report_file" default="/tmp/astra_swarm_uav1.csv"/>
  <arg name="uav2_report_file" default="/tmp/astra_swarm_uav2.csv"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include if="$(arg start_sim)"
           file="$(find astra_swarm_bringup)/launch/dual_px4_mavros.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="uav1_spawn_x" value="$(arg uav1_spawn_x)"/>
    <arg name="uav2_spawn_x" value="$(arg uav2_spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
  </include>

  <!-- Unified world to each vehicle-local control map. The planners remain
       independent; only the swarm state is expressed in world coordinates. -->
  <node if="$(arg uav1_enabled)"
        pkg="tf2_ros" type="static_transform_publisher"
        name="world_to_uav1_map"
        args="$(arg uav1_spawn_x) $(arg spawn_y) 0 0 0 0 1 world uav1/map"/>
  <node if="$(arg uav2_enabled)"
        pkg="tf2_ros" type="static_transform_publisher"
        name="world_to_uav2_map"
        args="$(arg uav2_spawn_x) $(arg spawn_y) 0 0 0 0 1 world uav2/map"/>

  <group if="$(arg uav1_enabled)" ns="uav1">
    <group>
      <remap from="/livox/lidar" to="/uav1/livox/lidar"/>
      <remap from="/livox/imu" to="/uav1/livox/imu"/>
      <remap from="/Odometry" to="/uav1/fast_lio/Odometry_raw"/>
      <remap from="/cloud_registered"
             to="/uav1/fast_lio/cloud_registered_raw"/>
      <remap from="/cloud_registered_body"
             to="/uav1/fast_lio/cloud_registered_body_raw"/>
      <remap from="/path" to="/uav1/fast_lio/path_raw"/>
      <remap from="/Laser_map" to="/uav1/fast_lio/Laser_map_raw"/>
      <remap from="/tf" to="/uav1/fast_lio/tf_raw"/>
      <include file="$(find fast_lio)/launch/mapping_mid360.launch">
        <arg name="rviz" value="false"/>
      </include>
    </group>

    <include file="$(find astra_swarm_bringup)/launch/uav_sensor_frames.launch">
      <arg name="frame_prefix" value="uav1"/>
      <arg name="model_name" value="uav1"/>
    </include>

    <node pkg="astra_swarm_tf" type="frame_adapter_node.py"
          name="frame_adapter" output="screen" required="true">
      <param name="frame_prefix" value="uav1"/>
      <param name="odom_input" value="/uav1/fast_lio/Odometry_raw"/>
      <param name="odom_output" value="/uav1/Odometry"/>
      <param name="cloud_input"
             value="/uav1/fast_lio/cloud_registered_raw"/>
      <param name="cloud_output" value="/uav1/cloud_registered"/>
      <param name="tf_input" value="/uav1/fast_lio/tf_raw"/>
      <param name="tf_output" value="/tf"/>
      <param name="mavros_pose_input"
             value="/uav1/mavros/local_position/pose"/>
      <param name="mavros_pose_output"
             value="/uav1/mavros/local_position/pose_framed"/>
      <param name="mavros_odom_output"
             value="/uav1/mavros/odometry/out"/>
    </node>

    <node pkg="astra_swarm_perception" type="teammate_cloud_filter_node"
          name="teammate_cloud_filter" output="screen" required="true">
      <rosparam command="load"
                file="$(find astra_swarm_perception)/config/dual_tower.yaml"/>
      <param name="input_topic" value="/uav1/cloud_registered"/>
      <param name="output_topic"
             value="/uav1/cloud_registered_peer_filtered"/>
      <rosparam param="peer_state_topics"
                subst_value="true">$(arg uav1_peer_state_topics)</rosparam>
      <param name="home_x" value="$(arg uav1_spawn_x)"/>
      <param name="home_y" value="$(arg spawn_y)"/>
      <param name="home_z" value="0.0"/>
    </node>

    <!-- Self and peer responsibilities remain separate.  The peer-filtered
         cloud is sampled against the odometry-synchronized, model-derived
         self mask before the existing ground filter/EGO input. -->
    <node pkg="astra_swarm_perception" type="self_cloud_filter_node"
          name="self_cloud_filter" output="screen" required="true">
      <rosparam command="load"
                file="$(find astra_swarm_perception)/config/iris_mid360_self_exclusion.yaml"/>
      <param name="input_topic"
             value="/uav1/cloud_registered_peer_filtered"/>
      <param name="odom_topic" value="/uav1/Odometry"/>
      <param name="output_topic"
             value="/uav1/cloud_registered_self_filtered"/>
      <param name="before_topic" value="/uav1/stage5/cloud_before_self"/>
      <param name="after_topic" value="/uav1/stage5/cloud_after_self"/>
      <param name="inflated_occupancy_topic"
             value="/uav1/stage3/occupancy_inflate"/>
      <param name="diagnostic_topic"
             value="/uav1/stage5/cloud_filter_diagnostics"/>
    </node>

    <group ns="swarm">
      <node pkg="astra_swarm_manager" type="swarm_state_publisher.py"
            name="state_publisher" output="screen" required="true">
        <param name="uav_id" value="1"/>
        <param name="vehicle_namespace" value="/uav1"/>
        <rosparam param="home_position"
                  subst_value="true">[$(arg uav1_spawn_x), $(arg spawn_y), 0.0]</rosparam>
        <param name="odom_topic" value="/uav1/Odometry"/>
        <param name="target_topic"
               value="/uav1/tower_mission/current_target"/>
        <param name="mission_state_topic"
               value="/uav1/tower_mission/state"/>
        <param name="bridge_state_topic"
               value="/uav1/ego_mavros_bridge/state"/>
        <param name="mavros_state_topic" value="/uav1/mavros/state"/>
        <param name="trajectory_prediction_horizon" value="4.0"/>
        <param name="trajectory_prediction_period" value="0.25"/>
        <param name="velocity_filter_alpha" value="0.25"/>
        <param name="acceleration_filter_alpha" value="0.15"/>
        <param name="maximum_prediction_speed" value="$(arg max_vel)"/>
        <param name="maximum_prediction_acceleration" value="$(arg max_acc)"/>
        <param name="heartbeat_timeout" value="1.0"/>
      </node>
    </group>
  </group>

  <group if="$(arg uav2_enabled)" ns="uav2">
    <group>
      <remap from="/livox/lidar" to="/uav2/livox/lidar"/>
      <remap from="/livox/imu" to="/uav2/livox/imu"/>
      <remap from="/Odometry" to="/uav2/fast_lio/Odometry_raw"/>
      <remap from="/cloud_registered"
             to="/uav2/fast_lio/cloud_registered_raw"/>
      <remap from="/cloud_registered_body"
             to="/uav2/fast_lio/cloud_registered_body_raw"/>
      <remap from="/path" to="/uav2/fast_lio/path_raw"/>
      <remap from="/Laser_map" to="/uav2/fast_lio/Laser_map_raw"/>
      <remap from="/tf" to="/uav2/fast_lio/tf_raw"/>
      <include file="$(find fast_lio)/launch/mapping_mid360.launch">
        <arg name="rviz" value="false"/>
      </include>
    </group>

    <include file="$(find astra_swarm_bringup)/launch/uav_sensor_frames.launch">
      <arg name="frame_prefix" value="uav2"/>
      <arg name="model_name" value="uav2"/>
    </include>

    <node pkg="astra_swarm_tf" type="frame_adapter_node.py"
          name="frame_adapter" output="screen" required="true">
      <param name="frame_prefix" value="uav2"/>
      <param name="odom_input" value="/uav2/fast_lio/Odometry_raw"/>
      <param name="odom_output" value="/uav2/Odometry"/>
      <param name="cloud_input"
             value="/uav2/fast_lio/cloud_registered_raw"/>
      <param name="cloud_output" value="/uav2/cloud_registered"/>
      <param name="tf_input" value="/uav2/fast_lio/tf_raw"/>
      <param name="tf_output" value="/tf"/>
      <param name="mavros_pose_input"
             value="/uav2/mavros/local_position/pose"/>
      <param name="mavros_pose_output"
             value="/uav2/mavros/local_position/pose_framed"/>
      <param name="mavros_odom_output"
             value="/uav2/mavros/odometry/out"/>
    </node>

    <node pkg="astra_swarm_perception" type="teammate_cloud_filter_node"
          name="teammate_cloud_filter" output="screen" required="true">
      <rosparam command="load"
                file="$(find astra_swarm_perception)/config/dual_tower.yaml"/>
      <param name="input_topic" value="/uav2/cloud_registered"/>
      <param name="output_topic"
             value="/uav2/cloud_registered_peer_filtered"/>
      <rosparam param="peer_state_topics"
                subst_value="true">$(arg uav2_peer_state_topics)</rosparam>
      <param name="home_x" value="$(arg uav2_spawn_x)"/>
      <param name="home_y" value="$(arg spawn_y)"/>
      <param name="home_z" value="0.0"/>
    </node>

    <node pkg="astra_swarm_perception" type="self_cloud_filter_node"
          name="self_cloud_filter" output="screen" required="true">
      <rosparam command="load"
                file="$(find astra_swarm_perception)/config/iris_mid360_self_exclusion.yaml"/>
      <param name="input_topic"
             value="/uav2/cloud_registered_peer_filtered"/>
      <param name="odom_topic" value="/uav2/Odometry"/>
      <param name="output_topic"
             value="/uav2/cloud_registered_self_filtered"/>
      <param name="before_topic" value="/uav2/stage5/cloud_before_self"/>
      <param name="after_topic" value="/uav2/stage5/cloud_after_self"/>
      <param name="inflated_occupancy_topic"
             value="/uav2/stage3/occupancy_inflate"/>
      <param name="diagnostic_topic"
             value="/uav2/stage5/cloud_filter_diagnostics"/>
    </node>

    <group ns="swarm">
      <node pkg="astra_swarm_manager" type="swarm_state_publisher.py"
            name="state_publisher" output="screen" required="true">
        <param name="uav_id" value="2"/>
        <param name="vehicle_namespace" value="/uav2"/>
        <rosparam param="home_position"
                  subst_value="true">[$(arg uav2_spawn_x), $(arg spawn_y), 0.0]</rosparam>
        <param name="odom_topic" value="/uav2/Odometry"/>
        <param name="target_topic"
               value="/uav2/tower_mission/current_target"/>
        <param name="mission_state_topic"
               value="/uav2/tower_mission/state"/>
        <param name="bridge_state_topic"
               value="/uav2/ego_mavros_bridge/state"/>
        <param name="mavros_state_topic" value="/uav2/mavros/state"/>
        <param name="trajectory_prediction_horizon" value="4.0"/>
        <param name="trajectory_prediction_period" value="0.25"/>
        <param name="velocity_filter_alpha" value="0.25"/>
        <param name="acceleration_filter_alpha" value="0.15"/>
        <param name="maximum_prediction_speed" value="$(arg max_vel)"/>
        <param name="maximum_prediction_acceleration" value="$(arg max_acc)"/>
        <param name="heartbeat_timeout" value="1.0"/>
      </node>
    </group>
  </group>

  <include if="$(arg uav1_enabled)"
           file="$(find astra_swarm_bringup)/launch/uav_tower_stack.launch">
    <arg name="mission_enabled" value="$(arg uav1_mission_enabled)"/>
    <arg name="require_start_permission"
         value="$(arg uav1_coordination_enabled)"/>
    <arg name="uav_ns" value="uav1"/>
    <arg name="uav_id" value="1"/>
    <arg name="planner_drone_id" value="0"/>
    <arg name="enable_control" value="$(arg uav1_enable_control)"/>
    <arg name="takeoff_delay" value="0.0"/>
    <arg name="planning_frame" value="uav1/camera_init"/>
    <arg name="mavros_frame" value="uav1/map"/>
    <arg name="inspection_top_height" value="$(arg uav1_top_height)"/>
    <arg name="layer_offsets" value="$(arg uav1_layer_offsets)"/>
    <arg name="candidate_height_offsets"
         value="$(arg uav1_candidate_height_offsets)"/>
    <arg name="takeoff_height" value="$(arg uav1_takeoff_height)"/>
    <arg name="staging_height" value="$(arg uav1_staging_height)"/>
    <arg name="low_altitude_enabled" value="$(arg low_altitude_enabled)"/>
    <arg name="coordination_enabled" value="$(arg uav1_coordination_enabled)"/>
    <arg name="orbit_permission_enabled"
         value="$(arg uav1_orbit_permission_enabled)"/>
    <arg name="orbit_speed_scale_enabled"
         value="$(arg uav1_orbit_speed_scale_enabled)"/>
    <arg name="entry_sector" value="$(arg uav1_entry_sector)"/>
    <arg name="entry_angle_deg" value="$(arg uav1_entry_angle_deg)"/>
    <arg name="pre_entry_radius" value="$(arg pre_entry_radius)"/>
    <arg name="entry_target_timeout" value="$(arg entry_target_timeout)"/>
    <arg name="inspection_laps" value="$(arg inspection_laps)"/>
    <arg name="mission_overall_timeout"
         value="$(arg mission_overall_timeout)"/>
    <arg name="low_altitude_floor_height" value="$(arg uav1_low_floor)"/>
    <arg name="low_altitude_ceiling_height" value="$(arg uav1_low_ceiling)"/>
    <arg name="task_config" value="$(arg task_config)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="ground_height" value="$(arg ground_height)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <arg name="mission_maximum_height"
         value="$(arg mission_maximum_height)"/>
    <arg name="mission_minimum_height"
         value="$(arg uav1_mission_minimum_height)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="prefer_clear_straight_corridor"
         value="$(arg prefer_clear_straight_corridor)"/>
    <arg name="swarm_origin_x" value="$(arg uav1_spawn_x)"/>
    <arg name="swarm_origin_y" value="$(arg spawn_y)"/>
    <arg name="tower_center_x"
         value="$(eval -10.0551 - float(arg('uav1_spawn_x')))"/>
    <arg name="tower_center_y"
         value="$(eval 19.7104 - float(arg('spawn_y')))"/>
    <arg name="crane_center_x"
         value="$(eval 2.7535 - float(arg('uav1_spawn_x')))"/>
    <arg name="bridge_config"
         value="$(find astra_swarm_bringup)/config/uav1_bridge.yaml"/>
    <arg name="report_file" value="$(arg uav1_report_file)"/>
    <arg name="trajectory_color_r" value="1.0"/>
    <arg name="trajectory_color_g" value="0.55"/>
    <arg name="trajectory_color_b" value="0.0"/>
  </include>

  <include if="$(arg uav2_enabled)"
           file="$(find astra_swarm_bringup)/launch/uav_tower_stack.launch">
    <arg name="mission_enabled" value="$(arg uav2_mission_enabled)"/>
    <arg name="require_start_permission"
         value="$(arg uav2_coordination_enabled)"/>
    <arg name="uav_ns" value="uav2"/>
    <arg name="uav_id" value="2"/>
    <arg name="planner_drone_id" value="1"/>
    <arg name="enable_control" value="$(arg uav2_enable_control)"/>
    <arg name="takeoff_delay" value="$(arg takeoff_delay)"/>
    <arg name="planning_frame" value="uav2/camera_init"/>
    <arg name="mavros_frame" value="uav2/map"/>
    <arg name="inspection_top_height" value="$(arg uav2_top_height)"/>
    <arg name="layer_offsets" value="$(arg uav2_layer_offsets)"/>
    <arg name="candidate_height_offsets"
         value="$(arg uav2_candidate_height_offsets)"/>
    <arg name="takeoff_height" value="$(arg uav2_takeoff_height)"/>
    <arg name="staging_height" value="$(arg uav2_staging_height)"/>
    <arg name="low_altitude_enabled" value="$(arg low_altitude_enabled)"/>
    <arg name="coordination_enabled" value="$(arg uav2_coordination_enabled)"/>
    <arg name="orbit_permission_enabled"
         value="$(arg uav2_orbit_permission_enabled)"/>
    <arg name="orbit_speed_scale_enabled"
         value="$(arg uav2_orbit_speed_scale_enabled)"/>
    <arg name="entry_sector" value="$(arg uav2_entry_sector)"/>
    <arg name="entry_angle_deg" value="$(arg uav2_entry_angle_deg)"/>
    <arg name="pre_entry_radius" value="$(arg pre_entry_radius)"/>
    <arg name="entry_target_timeout" value="$(arg entry_target_timeout)"/>
    <arg name="inspection_laps" value="$(arg inspection_laps)"/>
    <arg name="mission_overall_timeout"
         value="$(arg mission_overall_timeout)"/>
    <arg name="low_altitude_floor_height" value="$(arg uav2_low_floor)"/>
    <arg name="low_altitude_ceiling_height" value="$(arg uav2_low_ceiling)"/>
    <arg name="task_config" value="$(arg task_config)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="ground_height" value="$(arg ground_height)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <arg name="mission_maximum_height"
         value="$(arg mission_maximum_height)"/>
    <arg name="mission_minimum_height"
         value="$(arg uav2_mission_minimum_height)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="prefer_clear_straight_corridor"
         value="$(arg prefer_clear_straight_corridor)"/>
    <arg name="swarm_origin_x" value="$(arg uav2_spawn_x)"/>
    <arg name="swarm_origin_y" value="$(arg spawn_y)"/>
    <arg name="tower_center_x"
         value="$(eval -10.0551 - float(arg('uav2_spawn_x')))"/>
    <arg name="tower_center_y"
         value="$(eval 19.7104 - float(arg('spawn_y')))"/>
    <arg name="crane_center_x"
         value="$(eval 2.7535 - float(arg('uav2_spawn_x')))"/>
    <arg name="bridge_config"
         value="$(find astra_swarm_bringup)/config/uav2_bridge.yaml"/>
    <arg name="report_file" value="$(arg uav2_report_file)"/>
    <arg name="trajectory_color_r" value="0.0"/>
    <arg name="trajectory_color_g" value="0.75"/>
    <arg name="trajectory_color_b" value="1.0"/>
  </include>

  <group if="$(arg swarm_services_enabled)">
  <node pkg="astra_swarm_safety" type="swarm_safety_node.py"
        name="astra_swarm_safety" output="screen" required="true">
    <rosparam command="load"
              file="$(find astra_swarm_safety)/config/dual_tower.yaml"/>
    <rosparam param="uav_ids"
              subst_value="true">$(arg swarm_uav_ids)</rosparam>
    <rosparam param="mission_heights"
              subst_value="true">$(arg swarm_mission_heights)</rosparam>
    <rosparam param="phase_degrees"
              subst_value="true">$(arg swarm_phase_degrees)</rosparam>
    <rosparam param="tower_center"
              subst_value="true">$(arg swarm_tower_center)</rosparam>
    <rosparam param="home_positions"
              subst_value="true">$(arg swarm_home_positions)</rosparam>
    <rosparam param="takeoff_heights"
              subst_value="true">$(arg swarm_takeoff_heights)</rosparam>
    <param name="optimizer_swarm_clearance" value="$(arg swarm_clearance)"/>
  </node>
  </group>
  <node pkg="astra_swarm_bringup" type="px4_param_guard.py"
        name="astra_swarm_px4_param_guard" output="screen" required="true">
    <rosparam param="vehicle_namespaces"
              subst_value="true">$(arg swarm_vehicle_namespaces)</rosparam>
    <param name="ekf2_hgt_ref" value="3"/>
    <param name="ekf2_ev_ctrl" value="11"/>
  </node>
  <group if="$(arg swarm_services_enabled)">
  <node pkg="astra_swarm_manager" type="swarm_manager_node.py"
        name="astra_swarm_manager" output="screen" required="true">
    <rosparam command="load"
              file="$(arg swarm_manager_config)"/>
    <rosparam param="uav_ids"
              subst_value="true">$(arg swarm_uav_ids)</rosparam>
    <rosparam param="mission_heights"
              subst_value="true">$(arg swarm_mission_heights)</rosparam>
    <rosparam param="phase_degrees"
              subst_value="true">$(arg swarm_phase_degrees)</rosparam>
    <rosparam param="tower_center"
              subst_value="true">$(arg swarm_tower_center)</rosparam>
    <rosparam param="home_positions"
              subst_value="true">$(arg swarm_home_positions)</rosparam>
    <rosparam param="takeoff_heights"
              subst_value="true">$(arg swarm_takeoff_heights)</rosparam>
    <param name="optimizer_swarm_clearance" value="$(arg swarm_clearance)"/>
    <rosparam param="uav1_home_position"
              subst_value="true">[$(arg uav1_spawn_x), $(arg spawn_y), 0.0]</rosparam>
    <rosparam param="uav2_home_position"
              subst_value="true">[$(arg uav2_spawn_x), $(arg spawn_y), 0.0]</rosparam>
    <param name="takeoff_delay" value="$(arg takeoff_delay)"/>
    <param name="takeoff_interval_sec" value="$(arg takeoff_delay)"/>
    <param name="minimum_3d_separation" value="3.0"/>
    <param name="trajectory_timeout" value="1.0"/>
    <param name="orbit_radius" value="12.5"/>
    <param name="desired_phase_separation_degrees"
           value="$(arg desired_phase_separation_degrees)"/>
    <param name="phase_tolerance_degrees"
           value="$(arg phase_tolerance_degrees)"/>
    <param name="entry_nominal_speed" value="$(arg entry_nominal_speed)"/>
    <param name="orbit_nominal_speed" value="$(arg orbit_nominal_speed)"/>
    <rosparam param="formation_role_order"
              subst_value="true">$(arg formation_role_order)</rosparam>
    <param name="target_phase_deg" value="$(arg target_phase_deg)"/>
    <param name="normal_phase_min_deg" value="$(arg normal_phase_min_deg)"/>
    <param name="normal_phase_max_deg" value="$(arg normal_phase_max_deg)"/>
    <param name="warning_phase_min_deg" value="$(arg warning_phase_min_deg)"/>
    <param name="emergency_phase_deg" value="$(arg emergency_phase_deg)"/>
    <param name="leader_wait_phase_deg" value="$(arg leader_wait_phase_deg)"/>
    <param name="entry_ready_timeout" value="$(arg entry_ready_timeout)"/>
    <param name="uav2_takeoff_height" value="$(arg uav2_takeoff_height)"/>
    <param name="uav1_initial_height" value="$(arg uav1_top_height)"/>
    <param name="uav1_final_height" value="$(arg uav1_final_height)"/>
    <param name="uav2_initial_height" value="$(arg uav2_top_height)"/>
    <param name="uav2_final_height" value="$(arg uav2_final_height)"/>
  </node>
  </group>

  <node if="$(arg enable_cloud_fusion)"
        pkg="astra_swarm_perception" type="world_cloud_fusion_node"
        name="world_cloud_fusion" output="screen">
    <rosparam command="load"
              file="$(find astra_swarm_perception)/config/dual_tower.yaml"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz"
        name="astra_swarm_rviz" output="screen"
        args="-f world -d $(find astra_swarm_bringup)/config/dual_tower.rviz"/>
</launch>

<launch>
  <!-- Initialization-only entry point.  Control and all three mission nodes
       are deliberately hard-disabled rather than exposed as launch args. -->
  <arg name="gui" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="world"
       default="$(find env_map)/../../../astra_gazebo_worlds/outdoor_village.world"/>

  <!-- outdoor_village main_street is 4 m wide.  Its straight centerline is
       y=0 from x=-16 to x=10, so these 7 m-spaced poses stay on the road and
       clear the roadside lamps/cones around |y|=2.6..3.0.  The stable model
       spawn code retains z=0.06 m and yaw=0 rad (facing road +X). -->
  <arg name="uav1_spawn_x" default="-14.0"/>
  <arg name="uav2_spawn_x" default="-7.0"/>
  <arg name="uav3_spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>

  <include file="$(find astra_swarm_bringup)/launch/triple_tower_inspection.launch">
    <arg name="enable_control" value="false"/>
    <arg name="uav1_enable_control" value="false"/>
    <arg name="uav2_enable_control" value="false"/>
    <arg name="uav3_enable_control" value="false"/>
    <arg name="uav1_mission_enabled" value="false"/>
    <arg name="uav2_mission_enabled" value="false"/>
    <arg name="uav3_mission_enabled" value="false"/>
    <arg name="uav1_coordination_enabled" value="false"/>
    <arg name="uav2_coordination_enabled" value="false"/>
    <arg name="uav3_coordination_enabled" value="false"/>
    <arg name="swarm_services_enabled" value="false"/>
    <arg name="evidence_record_enabled" value="false"/>
    <arg name="start_rviz_diagnostics" value="false"/>
    <arg name="start_sim" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="uav1_spawn_x" value="$(arg uav1_spawn_x)"/>
    <arg name="uav2_spawn_x" value="$(arg uav2_spawn_x)"/>
    <arg name="uav3_spawn_x" value="$(arg uav3_spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="uav1_report_file" value="/dev/null"/>
    <arg name="uav2_report_file" value="/dev/null"/>
    <arg name="uav3_report_file" value="/dev/null"/>
  </include>
</launch>

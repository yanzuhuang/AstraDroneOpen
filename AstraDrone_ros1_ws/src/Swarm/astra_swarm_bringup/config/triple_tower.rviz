Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Three UAV Models1
        - /Independent Point Clouds1
        - /Independent EGO Trajectories1
        - /Actual Flight Paths1
        - /Mission Targets and Route1
        - /Mission Diagnostics1
      Splitter Ratio: 0.55
    Tree Height: 760
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: World Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 2
      Color: 120; 120; 120
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Name: Three UAV Models
      Enabled: true
      Displays:
        - Class: rviz/RobotModel
          Name: UAV1 Model
          Enabled: true
          Alpha: 1
          Collision Enabled: false
          Robot Description: /uav1/robot_description
          TF Prefix: uav1
          Update Interval: 0
          Visual Enabled: true
        - Class: rviz/RobotModel
          Name: UAV2 Model
          Enabled: true
          Alpha: 1
          Collision Enabled: false
          Robot Description: /uav2/robot_description
          TF Prefix: uav2
          Update Interval: 0
          Visual Enabled: true
        - Class: rviz/RobotModel
          Name: UAV3 Model
          Enabled: true
          Alpha: 1
          Collision Enabled: false
          Robot Description: /uav3/robot_description
          TF Prefix: uav3
          Update Interval: 0
          Visual Enabled: true
    - Class: rviz/Group
      Name: Independent Point Clouds
      Enabled: true
      Displays:
        - Class: rviz/PointCloud2
          Name: UAV1 Cloud (Orange)
          Enabled: true
          Topic: /uav1/cloud_registered_peer_filtered
          Alpha: 0.35
          Color: 255; 140; 0
          Color Transformer: FlatColor
          Decay Time: 1
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.04
          Style: Points
          Use Fixed Frame: true
        - Class: rviz/PointCloud2
          Name: UAV2 Cloud (Cyan)
          Enabled: true
          Topic: /uav2/cloud_registered_peer_filtered
          Alpha: 0.35
          Color: 0; 190; 255
          Color Transformer: FlatColor
          Decay Time: 1
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.04
          Style: Points
          Use Fixed Frame: true
        - Class: rviz/PointCloud2
          Name: UAV3 Cloud (Green)
          Enabled: true
          Topic: /uav3/cloud_registered_peer_filtered
          Alpha: 0.35
          Color: 80; 255; 60
          Color Transformer: FlatColor
          Decay Time: 1
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.04
          Style: Points
          Use Fixed Frame: true
    - Class: rviz/Group
      Name: Independent EGO Trajectories
      Enabled: true
      Displays:
        - Class: rviz/Marker
          Name: UAV1 EGO Trajectory (Orange)
          Enabled: true
          Marker Topic: /uav1/drone_0_ego_planner_node/optimal_list
          Queue Size: 100
        - Class: rviz/Marker
          Name: UAV2 EGO Trajectory (Cyan)
          Enabled: true
          Marker Topic: /uav2/drone_1_ego_planner_node/optimal_list
          Queue Size: 100
        - Class: rviz/Marker
          Name: UAV3 EGO Trajectory (Green)
          Enabled: true
          Marker Topic: /uav3/drone_2_ego_planner_node/optimal_list
          Queue Size: 100
        - Class: rviz/Marker
          Name: UAV1 EGO Goal
          Enabled: true
          Marker Topic: /uav1/drone_0_ego_planner_node/goal_point
          Queue Size: 20
        - Class: rviz/Marker
          Name: UAV2 EGO Goal
          Enabled: true
          Marker Topic: /uav2/drone_1_ego_planner_node/goal_point
          Queue Size: 20
        - Class: rviz/Marker
          Name: UAV3 EGO Goal
          Enabled: true
          Marker Topic: /uav3/drone_2_ego_planner_node/goal_point
          Queue Size: 20
    - Class: rviz/Group
      Name: Actual Flight Paths
      Enabled: true
      Displays:
        - Class: rviz/Path
          Name: UAV1 Actual Path
          Enabled: true
          Topic: /uav1/swarm/actual_path
          Color: 255; 140; 0
          Alpha: 1
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.08
        - Class: rviz/Path
          Name: UAV2 Actual Path
          Enabled: true
          Topic: /uav2/swarm/actual_path
          Color: 0; 190; 255
          Alpha: 1
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.08
        - Class: rviz/Path
          Name: UAV3 Actual Path
          Enabled: true
          Topic: /uav3/swarm/actual_path
          Color: 80; 255; 60
          Alpha: 1
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.08
    - Class: rviz/Group
      Name: Mission Targets and Route
      Enabled: true
      Displays:
        - Class: rviz/Pose
          Name: UAV1 Current Local Target
          Enabled: true
          Topic: /uav1/tower_mission/current_target
          Color: 255; 140; 0
          Shape: Arrow
          Shaft Length: 0.8
          Shaft Radius: 0.05
          Head Length: 0.25
          Head Radius: 0.1
        - Class: rviz/Pose
          Name: UAV2 Current Local Target
          Enabled: true
          Topic: /uav2/tower_mission/current_target
          Color: 0; 190; 255
          Shape: Arrow
          Shaft Length: 0.8
          Shaft Radius: 0.05
          Head Length: 0.25
          Head Radius: 0.1
        - Class: rviz/Pose
          Name: UAV3 Current Local Target
          Enabled: true
          Topic: /uav3/tower_mission/current_target
          Color: 80; 255; 60
          Shape: Arrow
          Shaft Length: 0.8
          Shaft Radius: 0.05
          Head Length: 0.25
          Head Radius: 0.1
        - Class: rviz/Path
          Name: UAV1 Mission Route
          Enabled: true
          Topic: /uav1/tower_mission/mission_route
          Color: 255; 170; 80
          Alpha: 0.45
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.04
        - Class: rviz/Path
          Name: UAV2 Mission Route
          Enabled: true
          Topic: /uav2/tower_mission/mission_route
          Color: 80; 210; 255
          Alpha: 0.45
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.04
        - Class: rviz/Path
          Name: UAV3 Mission Route
          Enabled: true
          Topic: /uav3/tower_mission/mission_route
          Color: 120; 255; 100
          Alpha: 0.45
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.04
        - Class: rviz/MarkerArray
          Name: WP1-WP8 and ENTRY-EXIT Gates
          Enabled: true
          Marker Topic: /swarm/rviz/mission_markers
          Queue Size: 10
    - Class: rviz/Group
      Name: Mission Diagnostics
      Enabled: true
      Displays:
        - Class: rviz/MarkerArray
          Name: UAV State Sector Safety Text
          Enabled: true
          Marker Topic: /swarm/rviz/status_markers
          Queue Size: 10
        - Class: rviz/TF
          Name: Independent TF Trees
          Enabled: true
          Frame Timeout: 15
          Marker Alpha: 0.75
          Marker Scale: 0.45
          Show Arrows: true
          Show Axes: true
          Show Names: true
          Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 28; 28; 32
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 58
      Enable Stereo Rendering:
        Value: false
      Field of View: 0.785398
      Focal Point:
        X: -10.0551
        Y: 19.7104
        Z: 4
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 960
  Width: 1500
  X: 40
  Y: 40

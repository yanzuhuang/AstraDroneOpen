Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Three UAV Models1
        - /FAST-LIO Point Clouds1
        - /EGO Local Planning1
        - /Actual Flight History1
        - /Main Waypoints1
      Splitter Ratio: 0.55
    Tree Height: 760
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 120; 120; 120
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Name: Three UAV Models
      Enabled: true
      Displays:
        - Class: rviz/RobotModel
          Name: uav1
          Enabled: true
          Alpha: 1
          Collision Enabled: false
          Robot Description: /uav1/robot_description
          TF Prefix: uav1
          Update Interval: 0
          Visual Enabled: true
        - Class: rviz/RobotModel
          Name: uav2
          Enabled: true
          Alpha: 1
          Collision Enabled: false
          Robot Description: /uav2/robot_description
          TF Prefix: uav2
          Update Interval: 0
          Visual Enabled: true
        - Class: rviz/RobotModel
          Name: uav3
          Enabled: true
          Alpha: 1
          Collision Enabled: false
          Robot Description: /uav3/robot_description
          TF Prefix: uav3
          Update Interval: 0
          Visual Enabled: true
    - Class: rviz/Group
      Name: FAST-LIO Point Clouds
      Enabled: true
      Displays:
        - Class: rviz/PointCloud2
          Name: uav1 cloud
          Enabled: true
          Topic: /uav1/stage3/cloud_registered_filtered
          Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 1
          Invert Rainbow: false
          Max Color: 255; 80; 80
          Min Color: 80; 120; 255
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Use Fixed Frame: true
          Use rainbow: true
        - Class: rviz/PointCloud2
          Name: uav2 cloud
          Enabled: true
          Topic: /uav2/stage3/cloud_registered_filtered
          Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 1
          Invert Rainbow: false
          Max Color: 255; 80; 80
          Min Color: 80; 120; 255
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Use Fixed Frame: true
          Use rainbow: true
        - Class: rviz/PointCloud2
          Name: uav3 cloud
          Enabled: true
          Topic: /uav3/stage3/cloud_registered_filtered
          Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 1
          Invert Rainbow: false
          Max Color: 255; 80; 80
          Min Color: 80; 120; 255
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Use Fixed Frame: true
          Use rainbow: true
    - Class: rviz/Group
      Name: EGO Local Planning
      Enabled: true
      Displays:
        - Class: rviz/Marker
          Name: uav1 local trajectory
          Enabled: true
          Marker Topic: /uav1/drone_0_ego_planner_node/optimal_list
          Queue Size: 100
        - Class: rviz/Marker
          Name: uav2 local trajectory
          Enabled: true
          Marker Topic: /uav2/drone_1_ego_planner_node/optimal_list
          Queue Size: 100
        - Class: rviz/Marker
          Name: uav3 local trajectory
          Enabled: true
          Marker Topic: /uav3/drone_2_ego_planner_node/optimal_list
          Queue Size: 100
        - Class: rviz/Marker
          Name: uav1 local goal
          Enabled: true
          Marker Topic: /uav1/drone_0_ego_planner_node/goal_point
          Queue Size: 20
        - Class: rviz/Marker
          Name: uav2 local goal
          Enabled: true
          Marker Topic: /uav2/drone_1_ego_planner_node/goal_point
          Queue Size: 20
        - Class: rviz/Marker
          Name: uav3 local goal
          Enabled: true
          Marker Topic: /uav3/drone_2_ego_planner_node/goal_point
          Queue Size: 20
    - Class: rviz/Group
      Name: Actual Flight History
      Enabled: true
      Displays:
        - Class: rviz/Path
          Name: uav1 history
          Enabled: true
          Topic: /uav1/swarm/actual_path
          Color: 255; 140; 0
          Alpha: 1
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.08
        - Class: rviz/Path
          Name: uav2 history
          Enabled: true
          Topic: /uav2/swarm/actual_path
          Color: 0; 190; 255
          Alpha: 1
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.08
        - Class: rviz/Path
          Name: uav3 history
          Enabled: true
          Topic: /uav3/swarm/actual_path
          Color: 80; 255; 60
          Alpha: 1
          Buffer Length: 1
          Line Style: Lines
          Line Width: 0.08
    - Class: rviz/Group
      Name: Main Waypoints
      Enabled: true
      Displays:
        - Class: rviz/MarkerArray
          Name: WP1-WP8
          Enabled: true
          Marker Topic: /swarm/rviz/mission_markers
          Queue Size: 10
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Alpha: 0.75
      Marker Scale: 0.45
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 58
      Enable Stereo Rendering:
        Value: false
      Field of View: 0.785398
      Focal Point:
        X: -10.0551
        Y: 19.7104
        Z: 4
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 960
  Width: 1500
  X: 40
  Y: 40

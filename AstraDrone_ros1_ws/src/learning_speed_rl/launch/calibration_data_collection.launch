<launch>
  <arg name="namespace" default="uav1"/>
  <arg name="run_id" default="manual"/>
  <arg name="output_dir"
       default="$(find learning_speed_rl)/../../../runtime_artifacts/learning_speed/calibration/manual"/>
  <arg name="start_observation_c" default="true"/>
  <arg name="cloud_topic" default="stage3/cloud_registered_filtered"/>
  <arg name="odom_topic" default="Odometry"/>
  <arg name="world_frame" default="$(arg namespace)/camera_init"/>
  <arg name="body_frame" default="$(arg namespace)/body"/>
  <arg name="sensor_frame" default="$(arg namespace)/mid360_link"/>
  <arg name="config_file"
       default="$(find learning_speed_rl)/config/calibration_data_collection.yaml"/>

  <!-- Observation C remains read-only.  Set false when an instance is already
       running in this namespace. -->
  <include if="$(arg start_observation_c)"
           file="$(find learning_speed_rl)/launch/observation_c_trajectory_fusion.launch">
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="trajectory_topic" value="planning/bspline"/>
    <arg name="ego_applied_v_max_topic" value="learning_speed/applied_v_max"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="sensor_frame" value="$(arg sensor_frame)"/>
    <arg name="trajectory_sampling_mode" value="distance"/>
  </include>

  <group ns="$(arg namespace)">
    <node pkg="learning_speed_rl" type="calibration_data_recorder.py"
          name="learning_speed_calibration_recorder" output="screen"
          required="true">
      <rosparam command="load" file="$(arg config_file)"/>
      <param name="run_id" value="$(arg run_id)"/>
      <param name="output_dir" value="$(arg output_dir)"/>
      <rosparam subst_value="true">
        tracking_safety:
          limit_m: 1.0
          duration_sec: 1.0
      </rosparam>
    </node>
  </group>
</launch>
